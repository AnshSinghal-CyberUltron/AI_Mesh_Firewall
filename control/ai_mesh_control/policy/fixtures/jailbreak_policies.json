[
  {
    "name": "Jailbreak: DAN/Mode Activation",
    "code": "JB_001",
    "category": "Jailbreak",
    "severity": "CRITICAL",
    "description": "Detects prompts attempting DAN (Do Anything Now) or similar mode-based jailbreak attacks, including common typo variants.",
    "enabled": true,
    "priority": 15,
    "metadata": {},
    "rules": [
      {
        "name": "dan mode keyword detection",
        "rule_type": "keywords",
        "condition": {
          "keywords": [
            "dan mode",
            "dav mode",
            "do anything now",
            "do anything mode",
            "you are in dan mode",
            "you are in dav mode",
            "enable dan mode",
            "activate dan mode",
            "switch to dan mode"
          ],
          "field": "prompt"
        },
        "action": "block",
        "redaction_config": {},
        "priority": 20,
        "enabled": true,
        "description": "Blocks prompts containing DAN/mode jailbreak activation keywords."
      },
      {
        "name": "dan mode regex detection",
        "rule_type": "regex",
        "condition": {
          "pattern": "(?i)(you\\s+are\\s+(now\\s+)?(in\\s+)?da[nv]\\s+mode|do\\s+anything\\s+now|enable\\s+da[nv]\\s+mode|switch\\s+to\\s+da[nv])",
          "field": "prompt"
        },
        "action": "monitor",
        "redaction_config": {},
        "priority": 25,
        "enabled": true,
        "description": "Monitors prompts matching DAN mode activation patterns."
      },
      {
        "name": "dan mode pattern variation",
        "rule_type": "pattern",
        "condition": {
          "pattern": "(?i).*da[nv]\\s+mode.*",
          "field": "prompt"
        },
        "action": "redact",
        "redaction_config": {},
        "priority": 30,
        "enabled": true,
        "description": "Redacts prompts containing DAN mode references."
      }
    ]
  },
  {
