# EC2 production — copy to .env on the instance (or sync from laptop via sync-to-ec2.sh).
#
# Deploy workflow (no app source on EC2):
#   Backend only:  make ecr-push TAG=v1.0.0 && make sync-ec2-deploy
#   UI only:       make frontend-build && make sync-ec2  (then recreate nginx on EC2)
#   Full stack:    make deploy-full-ec2 TAG=v1.0.0
#     (ECR push + frontend build + sync + remote pull/up)
#
# VITE_* below are compile-time (make frontend-build on laptop/CI), not read at nginx runtime on EC2.

# ── ECR (build/push from laptop or CI, then pull on EC2) ──
ECR_REGISTRY=935951870001.dkr.ecr.ap-south-1.amazonaws.com
IMAGE_TAG=v1.0.0
AWS_REGION=ap-south-1

# ── zeroshield.ai subdomains (Route53 A/AAAA → EC2) ──
FRONTEND_HOST=aimeshfirewall.zeroshield.ai
BACKEND_HOST=aimeshbackend.zeroshield.ai
GATEWAY_HOST=aimeshgateway.zeroshield.ai

# ── OpenAI-SDK reference demo (/demo/, superuser-gated via HTTP Basic Auth) ──
# DEMO_GATEWAY_KEY: a ZeroShield gateway key the demo authenticates with (server-side).
# DEMO_AUTH_USER/PASSWORD: Basic Auth credential baked into the nginx image at build.
# Leave DEMO_GATEWAY_KEY empty to disable the demo (it will start but AI calls 500).
DEMO_GATEWAY_KEY=
DEMO_GATEWAY_BASE_URL=http://gateway:8300/v1
DEMO_AUTH_USER=superuser
DEMO_AUTH_PASSWORD=change-me

# Use https:// when TLS terminates at ALB/CloudFront; use http:// if nginx :80 only.
FRONTEND_ORIGIN=https://aimeshfirewall.zeroshield.ai
BACKEND_PUBLIC_URL=https://aimeshbackend.zeroshield.ai
GATEWAY_PUBLIC_URL=https://aimeshgateway.zeroshield.ai
GATEWAY_CORS_ORIGINS=https://aimeshfirewall.zeroshield.ai,https://aimeshbackend.zeroshield.ai

VITE_FRONTEND_BASE_URL=https://aimeshfirewall.zeroshield.ai
VITE_BACKEND_BASE_URL=https://aimeshbackend.zeroshield.ai
# Dedicated gateway host for browser fetch + UI (set true only to force same-origin /v1 proxy).
VITE_GATEWAY_SAME_ORIGIN=false
VITE_GATEWAY_BASE_URL=https://aimeshgateway.zeroshield.ai
VITE_GATEWAY_SAME_ORIGIN=false
VITE_ENABLE_REALTIME_NOTIFICATIONS=true
SIMULATOR_DEFAULTS_ENABLED=true

ALLOWED_HOSTS=aimeshbackend.zeroshield.ai,aimeshfirewall.zeroshield.ai,aimeshgateway.zeroshield.ai,localhost,127.0.0.1,control

POSTGRES_USER=ai_mesh_firewall
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=ai_mesh_firewall

DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM
POLICY_SIGNING_KEY=CHANGE_ME_HEX_64
GATEWAY_INTERNAL_API_KEY=CHANGE_ME_HEX_32

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

DEBUG=false
ENABLE_TIER2=true
GATEWAY_RAG_ENABLED=true
# BYOK vector providers: configure per-org in UI (Vector Provider Config).
# Gateway env CHROMA_URL intentionally empty on prod — do not set unless local dev.
CHROMA_URL=
GATEWAY_TIER2_SAMPLE_RATE=1.0
WEB_CONCURRENCY=6

# ── c8g.2xlarge gateway tuning (per-worker pools; 6 workers × pool = cluster total) ──
GATEWAY_SCANNER_THREAD_POOL_SIZE=4
GATEWAY_BEDROCK_THREAD_POOL_SIZE=8
GATEWAY_VAULT_POOL_MIN=1
GATEWAY_VAULT_POOL_MAX=4
GATEWAY_REDIS_MAX_CONNECTIONS=100
GATEWAY_TIER2_CACHE_MAX=3000
GUNICORN_WORKER_CONNECTIONS=1000

# Background Celery (keep low on single-box — tier-2 runs on gateway sync path)
CELERY_WORKER_CONCURRENCY=2

# Control plane DB/cache connection caps (pair with postgres max_connections=100 in prod overlay)
POSTGRES_CONN_MAX_AGE=30
DJANGO_CACHE_MAX_CONNECTIONS=50

# Bedrock / tier-2 breaker (tune under throttle — do not raise WEB_CONCURRENCY instead)
# BEDROCK_TIMEOUT=60
# TIER2_BREAKER_MIN_CALLS=10
# TIER2_BREAKER_FAILURE_THRESHOLD=0.5
# TIER2_BREAKER_WINDOW_SECONDS=60
# TIER2_BREAKER_COOLDOWN_SECONDS=30

# On EC2 leave empty — use instance IAM role (do NOT use quarantined BedrockAPIKey-* users for ECR)
# On laptop: leave empty for ECR push too — make ecr-push uses your default AWS CLI profile, not these keys.
USE_EC2_INSTANCE_ROLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_REGION=ap-south-1
# Platform Bedrock (ZeroShield IAM) — guard/adjudicator/Tier-2 only; NOT org BYOK inference
BEDROCK_TIER2_SCANNER_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_ADJUDICATOR_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=256
BEDROCK_ADJUDICATOR_MAX_TOKENS=200
# Legacy fallback when TIER2/ADJUDICATOR unset
BEDROCK_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Display name for pipeline trace only — NOT a LiteLLM model id
ZEROSHIELD_GUARD_MODEL_NAME=zeroshield-guard-120b

TELEMETRY_DRAIN_MODE=thread
ALERT_EMAIL_USE_CELERY=false
GATEWAY_MONGO_TELEMETRY_ENABLED=false

# Module 3 — LLMOps admission (gateway)
MODULE3_ADMISSION_MODE=passthrough
MODULE3_COSIGN_PUBLIC_KEY=

# ── CloudWatch observability (one-time terraform: infra/terraform/envs/ec2-demo) ──
# Compose overlay: docker-compose.observability.yml (set EC2_OBSERVABILITY=1 on deploy)
EC2_OBSERVABILITY=1
CLOUDWATCH_LOG_GROUP_GATEWAY=/ai-mesh-firewall/ec2/gateway
CLOUDWATCH_LOG_GROUP_CONTROL=/ai-mesh-firewall/ec2/control
CLOUDWATCH_LOG_GROUP_WORKERS=/ai-mesh-firewall/ec2/workers
CLOUDWATCH_LOG_GROUP_NGINX=/ai-mesh-firewall/ec2/nginx
CW_AGENT_CONFIG_SSM=/ai-mesh-firewall/ec2/cloudwatch-agent/config
CW_STACK_METRIC_NAMESPACE=AIMeshFirewall/EC2
CW_ALARM_PREFIX=ai-mesh-firewall-demo-
# EC2_INSTANCE_ID=i-xxxxxxxx  # for scripts/demo-ec2-lifecycle.sh stop|start
DEMO_ALARM_GRACE_SECONDS=900

# JSON logs for CloudWatch metric filters; no prompt preview in CW
GATEWAY_LOG_JSON=true
DJANGO_LOG_JSON=true
GATEWAY_LOG_LEVEL=INFO
LOG_LEVEL=INFO
BEDROCK_LOG_LEVEL=INFO
BEDROCK_LOG_PROMPT_PREVIEW=false

# Prometheus scrape auth for GET /metrics (required in production; bind 0.0.0.0:8300)
METRICS_SCRAPER_KEY=change-me-long-random-scraper-secret
METRICS_ALLOW_OPEN=false
