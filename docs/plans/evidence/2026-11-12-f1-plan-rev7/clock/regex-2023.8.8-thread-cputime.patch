+/* AMF patch (thread CPU timeout): the 'timeout' argument is measured in the
+ * CPU time of the thread that is matching, read with
+ * clock_gettime(CLOCK_THREAD_CPUTIME_ID). Upstream used C clock(), which on
+ * POSIX is the CPU time of the whole process, so work on any other thread
+ * shortened every timeout. CLOCK_THREAD_CPUTIME_ID is POSIX: Linux, and macOS
+ * 10.12 or later. There is deliberately no fallback to clock(): a platform
+ * without it (Windows) fails to build rather than silently measuring process
+ * time.
+ */
+#if !defined(CLOCK_THREAD_CPUTIME_ID)
+#error "regex (AMF patch): CLOCK_THREAD_CPUTIME_ID is required (POSIX only)"
+#endif
+
+/* Timeout ticks per second: microseconds, the same unit as upstream (POSIX
+ * requires CLOCKS_PER_SEC to be 1000000).
+ */
+#define RE_TICKS_PER_SEC 1000000
 
