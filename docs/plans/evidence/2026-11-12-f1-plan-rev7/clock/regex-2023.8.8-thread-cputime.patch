+/* Returns the calling thread's CPU time in ticks, or -1 if it can't be read. */
+Py_LOCAL_INLINE(int64_t) thread_cpu_ticks(void) {
+    struct timespec ts;
+
+    if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts) != 0)
+        return -1;
+
+    return (int64_t)ts.tv_sec * RE_TICKS_PER_SEC +
+      (int64_t)ts.tv_nsec / (1000000000 / RE_TICKS_PER_SEC);
+}
