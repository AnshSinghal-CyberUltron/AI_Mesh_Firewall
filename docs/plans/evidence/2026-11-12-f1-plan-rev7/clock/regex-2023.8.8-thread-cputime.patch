+    if (PyThread_get_thread_ident() != state->start_thread) {
+        PyErr_SetString(PyExc_TimeoutError,
+          "regex timed out (timeout started on another thread)");
+        return TRUE;
+    }
+
+    now = thread_cpu_ticks();
+    if (now >= 0 && state->start_time >= 0 && now >= state->start_time &&
+      now - state->start_time < (int64_t)state->timeout)
         /* Hasn't timed out yet. */
         return FALSE;
 
