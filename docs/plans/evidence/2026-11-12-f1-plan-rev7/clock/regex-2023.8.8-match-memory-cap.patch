+/* AMF: the per-state cap on match-time storage growth, set once per process by
+ * set_match_memory_limit() (0: no cap), and the largest growth any finished
+ * state has charged (an observability hook, read by match_memory_peak()). */
+static size_t amf_match_memory_limit = 0;
+static size_t amf_match_memory_peak = 0;
+
+/* AMF: charges the growth of a match-time buffer (the backtracking, structure
+ * and pruning stacks, a group's capture list, a guard list) against the state's
+ * byte cap. Those buffers only ever grow during a state's life, so the charge is
+ * the bytes they hold. Fails closed: MemoryError, and the match stops.
+ */
+Py_LOCAL_INLINE(BOOL) charge_growth(RE_State* state, size_t old_bytes, size_t
+  new_bytes) {
+    size_t grow;
+
+    if (new_bytes <= old_bytes)
+        return TRUE;
+
+    grow = new_bytes - old_bytes;
+
+    if (state->mem_limit && (grow > state->mem_limit || state->mem_used >
+      state->mem_limit - grow)) {
+        acquire_GIL(state);
+        PyErr_SetString(PyExc_MemoryError,
+          "regex match memory limit exceeded");
+        release_GIL(state);
+        return FALSE;
+    }
+
+    state->mem_used += grow;
+
+    return TRUE;
+}
