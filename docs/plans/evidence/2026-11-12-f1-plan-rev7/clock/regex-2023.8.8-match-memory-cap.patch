+/* AMF: sets the per-state cap on match-time storage growth (bytes; 0: none). */
+static PyObject* set_match_memory_limit(PyObject* self, PyObject* args) {
+    Py_ssize_t limit;
+
+    if (!PyArg_ParseTuple(args, "n:set_match_memory_limit", &limit))
+        return NULL;
+
+    if (limit < 0) {
+        PyErr_SetString(PyExc_ValueError, "the limit must be >= 0");
+        return NULL;
+    }
+
+    amf_match_memory_limit = (size_t)limit;
+
+    Py_RETURN_NONE;
+}
+
+/* AMF: returns (cap, largest growth charged by a finished state), and resets
+ * the latter if asked. */
+static PyObject* match_memory_peak(PyObject* self, PyObject* args) {
+    int reset = 0;
+    PyObject* result;
+
+    if (!PyArg_ParseTuple(args, "|p:match_memory_peak", &reset))
+        return NULL;
+
+    result = Py_BuildValue("nn", (Py_ssize_t)amf_match_memory_limit,
+      (Py_ssize_t)amf_match_memory_peak);
+
+    if (reset)
+        amf_match_memory_peak = 0;
+
+    return result;
+}
