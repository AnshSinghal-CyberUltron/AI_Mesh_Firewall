DJANGO_SECRET_KEY=v1bench-harness-not-a-secret-do-not-deploy
DEBUG=False
MCP_BROKER_INTERNAL_KEY=v1bench-harness-broker-key
POLICY_SIGNING_KEY=v1bench-harness-signing-key-not-a-secret
