---- config_sync.py:400-410
   400          # Per-request path passed an explicit but empty org → do not scan and
   401          # merge every org's model configs (the fan-out amplifier). The global
   402          # scan is reserved for the no-argument startup load.
   403          if org_slug is not _UNSET and not org_slug:
