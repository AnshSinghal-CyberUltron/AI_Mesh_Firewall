   410                  await self._reload_llm_models(client, org_slug=effective_org)
---- config_sync.py:419-424
   419      def _reload_lock_for(self, org_key: str) -> asyncio.Lock:
   420          lock = self._reload_locks.get(org_key)
   421          if lock is None:
   422              lock = asyncio.Lock()
   423              self._reload_locks[org_key] = lock
   424          return lock
---- config_sync.py:450-465
   450      @staticmethod
   451      def _merge_org_into_router(llm_router: Any, slug: str, org_models: list) -> list:
   452          """Keep other orgs' LiteLLM deployments; replace this org's.
   453  
   454          Per-org ``reload_models_now(org_slug=…)`` must not rebuild the router
   455          from only that tenant's models (that dropped every other org → 422
   456          ``no_provider_configured`` under concurrent chat).
   457          """
   458          existing: list = []
   459          inner = getattr(llm_router, "_router", None)
   460          model_list = getattr(inner, "model_list", None) if inner is not None else None
   461          if isinstance(model_list, list):
   462              for entry in model_list:
   463                  if isinstance(entry, dict) and entry.get("_zs_org") != slug:
   464                      existing.append(dict(entry))
   465          return existing + list(org_models)
