   120      @property
   121      def ttft_ms(self) -> float:
   122          if self.first_token_ts <= 0 or self.provider_start_ts <= 0:
   123              return 0.0
   124          return (self.first_token_ts - self.provider_start_ts) * 1000
   125  
   126      @property
   127      def duration_ms(self) -> float:
   128          if self.provider_start_ts <= 0:
   129              return 0.0
   130          end = time.perf_counter()
   131          return (end - self.provider_start_ts) * 1000
