@@ -0,0 +1,180 @@
+"""Every /metrics family is TYPED (M4a): exactly one `# TYPE` line per family, followed by all of its samples.
+
+RC2 exposed untyped samples. prometheus_client parses those as type "unknown", and Google Managed Prometheus stores
+them as prometheus.googleapis.com/<name>/unknown, so the HPA's `rv2_signal|gauge` query finds nothing (r2-gke).
+The gateway, guard and unit node exporters (through their HTTP surface) and the worker's own GET /metrics route
+are parsed by prometheus_client. The suite runs under 0.21.1 (the venv) and 0.25.0 (PYTHONPATH), and the text is
+checked directly as well: a family typed twice, a family split into two groups, or a sample outside its family's
+TYPE group fails the test.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import gc
+import os
+import threading
+import time
+import urllib.request
+from collections.abc import Iterator
+from http.server import ThreadingHTTPServer
+from importlib.metadata import version
+from types import SimpleNamespace
+
+import pytest
+from prometheus_client.parser import text_string_to_metric_families
+
+from rvproto.edge import ops
+from rvproto.edge.exporter_http import handler
+from rvproto.runtime.exporter import NodeExporter
+from rvproto.runtime.loopguard import install_gc_probe
+from rvproto.runtime.metrics import Registry, label
+from rvproto.runtime.shm_metrics import ShmRegistry
+
+TAG = f"pt{os.getpid()}"
+PC = version("prometheus_client")
+
+
+def typed(text: str) -> dict[str, str]:
+    """{family: type} as prometheus_client parses the exposition (counter families drop `_total`), cross-checked
+    against the `# TYPE` lines. Fails on an untyped family, a family typed twice or split, or a sample outside
+    its family's TYPE group."""
+    parsed: dict[str, str] = {}
+    for fam in text_string_to_metric_families(text):
+        assert fam.type in ("counter", "gauge"), f"prometheus_client {PC}: {fam.name} parsed as {fam.type!r}"
+        assert fam.name not in parsed, f"prometheus_client {PC}: family {fam.name} appears twice (split)"
+        parsed[fam.name] = fam.type
+    declared: dict[str, str] = {}
+    cur = None
+    for line in text.splitlines():
+        if line.startswith("# TYPE "):
+            _, _, name, typ = line.split(" ")
+            assert name not in declared, f"{name}: typed twice"
+            declared[name], cur = typ, name
+        elif line.strip() and not line.startswith("#"):
+            name = line.split("{", 1)[0].split(" ", 1)[0]
+            assert name == cur, f"{name}: sample outside its family's TYPE group ({cur})"
+    assert {n.removesuffix("_total") if t == "counter" else n: t for n, t in declared.items()} == parsed
+    return parsed
+
+
+@pytest.fixture(autouse=True)
+def gc_probes() -> Iterator[None]:
+    n = len(gc.callbacks)
+    yield
+    del gc.callbacks[n:]  # install_gc_probe registers a process-wide callback
+
+
+def _worker(tag: str, i: int) -> ShmRegistry:
+    reg = ShmRegistry(i, tag=tag, role="w", slots=(96, 512, 512))
+    install_gc_probe(reg)  # gc_pause_ns{gen=...}: a histogram with labels
+    gc.collect()
+    reg.observe("loop_lag_ns", 180_000 + i)
+    reg.inc("admitted", 5 + i)
+    reg.inc(label("quota_admitted_tokens", org="org-a"), 7)
+    reg.set("worker_ready", 1.0)  # a per-process gauge: worker="<i>" after the merge
+    reg.set(label("plan_version_info", org="org-a", version="a-1"), 1.0)
+    return reg
+
+
+def _owner(tag: str, i: int) -> ShmRegistry:
+    reg = ShmRegistry(i, tag=tag, role="o", slots=(96, 512, 512))
+    install_gc_probe(reg)
+    gc.collect()
+    reg.inc("owner_requests", 40)
+    reg.inc("admitted", 1)  # the same family as the workers' counter: role="owner", ONE group
+    reg.inc(label("owner_shed_reason", reason="queue_bound"))
+    reg.observe("guard_exec_ns", 2_000_000)
+    reg.set("owner_backlog_ns", 250_000.0)
+    return reg
+
+
+def _scrape(exp: NodeExporter) -> str:
+    srv = ThreadingHTTPServer(("127.0.0.1", 0), handler(exp))
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    try:
+        with urllib.request.urlopen(f"http://127.0.0.1:{srv.server_address[1]}/metrics", timeout=10) as r:
+            return r.read().decode()
+    finally:
+        srv.shutdown()
+        srv.server_close()
+
+
+@pytest.mark.parametrize("kind", ["gateway", "guard", "unit"])
+def test_node_exporter_families_are_all_typed(kind: str) -> None:
+    tag = f"{TAG}{kind[0]}"
+    workers = [] if kind == "guard" else [_worker(tag, 0), _worker(tag, 1)]
+    owners = [] if kind == "gateway" else [_owner(tag, 0), _owner(tag, 1)]
+    exp = NodeExporter(tag=tag, kind=kind, metrics_dir="", dump_s=0, host="127.0.0.1", port=0, export_s=60,
+                       draining=lambda: False, push=None)
+    try:
+        state: dict[str, object] = {"t": time.monotonic(), "ticks": {}, "merged": None, "owner": {}}  # RC2 keys too
+        exp._signal_tick(state)
+        for reg in (*workers, *owners):
+            reg.inc("admitted", 2)
+        exp._signal_tick(state)  # a second window: the rates exist too
+        fams = typed(_scrape(exp))
+        assert fams["rv2_signal"] == "gauge"  # what the HPA asks for: prometheus.googleapis.com|rv2_signal|gauge
+        assert fams["rv_admitted"] == "counter"  # workers' and owners' series under ONE # TYPE
+        assert fams["rv_gc_pause_ns"] == "gauge"  # histogram statistics: computed values, not _bucket samples
+        if workers:
+            assert fams["rv_loop_lag_ns"] == "gauge" and fams["rv_worker_ready"] == "gauge"
+            assert fams["rv_quota_admitted_tokens"] == "counter" and fams["rv_plan_version_info"] == "gauge"
+        if owners:
+            assert fams["rv_owner_requests"] == "counter" and fams["rv_owner_shed_reason"] == "counter"
+            assert fams["rv_guard_exec_ns"] == "gauge" and fams["rv_owner_backlog_ns"] == "gauge"
+    finally:
+        for reg in (*workers, *owners):
+            reg.close()
+        exp.cleanup()
+
+
+def _serve(reg: Registry, path: str) -> tuple[int, dict[bytes, bytes], bytes]:
+    """GET `path` through the worker's ops routes (ops.handle), as the serving port answers it."""
+    st = SimpleNamespace(
+        metrics=reg, active_streams=1,
+        audit=SimpleNamespace(completeness=lambda: 1.0, produced=3, dropped=0, queue_stats=lambda: (0, 0.0)),
+        plans=SimpleNamespace(age_s=lambda: 0.2, versions=lambda: {"org-a": "a-1"}),
+        ks=SimpleNamespace(age_s=lambda: 0.1, orgs=frozenset({"org-a"}), models=frozenset({"m-1"})),
+        gate=SimpleNamespace(gauges=lambda: {"inflight_requests": 1.0}), guard=SimpleNamespace(),
+        admission=SimpleNamespace(lease=SimpleNamespace(held=lambda: {"org-a": 93})))
+    sent: list[dict[str, object]] = []
+
+    async def send(msg: dict[str, object]) -> None:
+        sent.append(msg)
+
+    async def receive() -> dict[str, object]:
+        return {"type": "http.request", "body": b"", "more_body": False}
+
+    assert asyncio.run(ops.handle(st, {"path": path, "method": "GET"}, receive, send))  # type: ignore[arg-type]
+    return sent[0]["status"], dict(sent[0]["headers"]), sent[1]["body"]  # type: ignore[arg-type,return-value]
+
+
+@pytest.mark.parametrize("shm", [False, True], ids=["c38-off", "c38-on"])
+def test_worker_metrics_route_families_are_all_typed(shm: bool) -> None:
+    reg: Registry = ShmRegistry(3, tag=f"{TAG}r", role="w", slots=(96, 512, 512)) if shm else Registry(3)
+    try:
+        install_gc_probe(reg)
+        gc.collect()
+        reg.observe("loop_lag_ns", 90_000)
+        reg.inc("admitted", 4)
+        status, headers, body = _serve(reg, "/metrics")
+        assert status == 200 and headers[b"content-type"].startswith(b"text/plain; version=0.0.4")
+        fams = typed(body.decode())
+        assert fams["rv_admitted"] == "counter" and fams["rv_loop_lag_ns"] == "gauge"
+        assert fams["rv_plan_version_info"] == "gauge" and fams["rv_lease_held_tokens"] == "gauge"
+        assert fams["rv_audit_completeness_ratio"] == "gauge"
+    finally:
+        if isinstance(reg, ShmRegistry):
+            reg.close()
+
+
+def test_a_type_clash_or_a_repeat_is_left_out_and_counted_never_a_second_type() -> None:
+    """One family, one type: a gauge that reuses a counter's series name is left out (counted), not re-typed."""
+    from rvproto.runtime.metrics import render
+
+    text = render([({"hist": {}, "count": {"x": 1}, "gauge": {}}, ())],
+                  samples=[("rv_x_total", "gauge", "2"), ("rv_x_total", "counter", "3"), ("rv2_signal", "gauge", "1")])
+    fams = typed(text)
+    assert fams == {"rv_x": "counter", "rv2_signal": "gauge"}
+    assert "rv_x_total 1" in text and "# rvproto: 2 series left out" in text
diff -ruN '--exclude=.venv' '--exclude=__pycache__' '--exclude=.hypothesis' '--exclude=.pytest_cache' '--exclude=.import_linter_cache' '--exclude=.run' '--exclude=*.pyc' base/tests/unit/test_signal_windows.py work/tests/unit/test_signal_windows.py
--- base/tests/unit/test_signal_windows.py	1970-01-01 05:30:00.000000000 +0530
+++ work/tests/unit/test_signal_windows.py	2026-09-24 19:11:05.903187419 +0530
@@ -0,0 +1,212 @@
+"""Reset-safe windowed signals (M4b) and GPU busy measured over the window (M4c), across real process restarts.
+
+A worker's or an owner's counters live in its own shared-memory segment, and they start again from zero when the
+process restarts. The launcher restarts a dead owner in place, under the same segment name. RC2 computed a window's
+increase as (counters now) - (previous sample, matched by segment name), which fails three ways:
+  - an owner restart gave one NEGATIVE window of owner_requests_per_s (and of owner_shed_per_s and
+    owner_queue_ms_avg);
+  - a worker restart gave a negative requests_per_s;
+  - an exporter restart published requests_per_s = 0.0, which an autoscaler reads as an idle node.
+In these tests, real child processes own the segments. A restart is a SIGKILL followed by a new child with the same
+index: a new pid, a new start time, and counters from zero. The expected behaviour is Prometheus counter semantics,
+applied per process:
+  - each window reports its true increase, never a negative one;
+  - a signal with no baseline is left out, never published as 0.0;
+  - gpu_busy_pct is the owners' engine execution time over the window, in percent.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+import time
+from collections.abc import Iterator
+from pathlib import Path
+
+import pytest
+
+from rvproto.runtime.exporter import NodeExporter
+
+ROOT = Path(__file__).resolve().parents[2]
+TAG = f"sw{os.getpid()}"
+CHILD = """
+import sys
+from rvproto.runtime.shm_metrics import ShmRegistry
+reg = ShmRegistry(int(sys.argv[3]), tag=sys.argv[1], role=sys.argv[2], slots=(16, 32, 32))
+print("up", flush=True)
+for line in sys.stdin:
+    op, name, v = line.split()
+    reg.inc(name, int(v)) if op == "inc" else reg.observe(name, int(v))
+    print("ok", flush=True)
+"""
+
+
+class Proc:
+    """A worker / owner stand-in: a real process that owns a C38 segment; do() applies updates and waits for them."""
+
+    def __init__(self, tag: str, role: str, index: int) -> None:
+        self.p = subprocess.Popen([sys.executable, "-c", CHILD, tag, role, str(index)], cwd=ROOT,
+                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
+        assert self.p.stdout is not None and self.p.stdout.readline().strip() == "up"
+
+    def do(self, *ops: tuple[str, str, int]) -> None:
+        assert self.p.stdin is not None and self.p.stdout is not None
+        self.p.stdin.write("".join(f"{op} {name} {v}\n" for op, name, v in ops))
+        self.p.stdin.flush()
+        assert [self.p.stdout.readline().strip() for _ in ops] == ["ok"] * len(ops)
+
+    def crash(self) -> None:
+        """SIGKILL: the process is gone, its segment file stays behind (as after a real crash)."""
+        self.p.kill()
+        self.p.wait()
+
+
+def _exporter(tag: str) -> NodeExporter:
+    return NodeExporter(tag=tag, kind="unit", metrics_dir="", dump_s=0, host="127.0.0.1", port=0, export_s=60,
+                        draining=lambda: False, push=None)
+
+
+def _tick(exp: NodeExporter, st: dict[str, object]) -> dict[str, float]:
+    exp._signal_tick(st)
+    return dict(exp.signals)
+
+
+def _increase(sig: dict[str, float], rate: str) -> float:
+    """The window's increase behind a per-second rate (window_s states the window)."""
+    return sig[rate] * sig["window_s"]
+
+
+class Node:
+    """One node: its exporter, its worker / owner processes, and the exporter's signal-loop state."""
+
+    def __init__(self, tag: str) -> None:
+        self.tag, self.exp = tag, _exporter(tag)
+        self.procs: list[Proc] = []
+        self.st: dict[str, object] = {"t": time.monotonic(), "ticks": {}, "merged": None, "owner": {}}  # RC2 keys too
+
+    def start(self, role: str, index: int = 0) -> Proc:
+        p = Proc(self.tag, role, index)
+        self.procs.append(p)
+        return p
+
+    def tick(self) -> dict[str, float]:
+        return _tick(self.exp, self.st)
+
+
+@pytest.fixture
+def node(request: pytest.FixtureRequest) -> Iterator[Node]:
+    n = Node(f"{TAG}{request.node.name.split('_')[2]}")  # one tag per test: no shared segments
+    try:
+        yield n
+    finally:
+        for p in n.procs:
+            p.crash()
+        n.exp.cleanup()
+
+
+def test_a_first_window_leaves_the_rates_out_never_zero(node: Node) -> None:
+    w, o = node.start("w"), node.start("o")
+    w.do(("inc", "admitted", 1000))
+    o.do(("inc", "owner_requests", 5000), ("obs", "guard_exec_ns", 900_000_000))
+    sig = node.tick()  # the exporter's first window (a node or exporter restart): no baseline
+    rates = ("requests_per_s", "owner_requests_per_s", "owner_shed_per_s", "gpu_busy_pct", "cpu_cores_busy",
+             "cpu_utilization")
+    assert not {k: sig[k] for k in rates if k in sig}  # RC2: requests_per_s and cpu_* 0.0, an idle node
+    w.do(("inc", "admitted", 50))
+    sig = node.tick()
+    assert _increase(sig, "requests_per_s") == pytest.approx(50) and sig["cpu_cores_busy"] >= 0.0
+    # an exporter restart: the new exporter's first window leaves the rates out again (RC2: requests_per_s 0.0)
+    sig = _tick(_exporter(node.tag), {"t": time.monotonic(), "ticks": {}, "merged": None, "owner": {}})
+    assert not {k: sig[k] for k in rates if k in sig}
+
+
+def test_a_worker_or_owner_restart_never_gives_a_negative_window(node: Node) -> None:
+    w, o = node.start("w"), node.start("o")
+    w.do(("inc", "admitted", 1000))
+    o.do(("inc", "owner_requests", 5000), ("inc", "owner_shed", 40))
+    node.tick()
+    w.do(("inc", "admitted", 50))
+    o.do(("inc", "owner_requests", 30))
+    sig = node.tick()
+    assert _increase(sig, "requests_per_s") == pytest.approx(50)
+    assert _increase(sig, "owner_requests_per_s") == pytest.approx(30)
+    assert _increase(sig, "owner_shed_per_s") == pytest.approx(0)
+
+    # both crash and are restarted in place: the same segment names, counters from zero
+    w.crash()
+    o.crash()
+    w, o = node.start("w"), node.start("o")
+    w.do(("inc", "admitted", 3))
+    o.do(("inc", "owner_requests", 7), ("inc", "owner_shed", 1))
+    sig = node.tick()
+    got = {k: _increase(sig, k) for k in ("requests_per_s", "owner_requests_per_s", "owner_shed_per_s")}
+    # RC2: 3 - 1050 = -1047, 7 - 5030 = -5023, 1 - 40 = -39 (the new process's count minus the old one's)
+    assert got == pytest.approx({"requests_per_s": 3, "owner_requests_per_s": 7, "owner_shed_per_s": 1})
+    assert sig["owner_queue_ms_avg"] >= 0.0 and sig["owner_queue_windows_avg"] >= 0.0
+    assert sig["cpu_cores_busy"] > 0.0  # the restarted processes' CPU (their start-up) is in this window
+
+    # the next window pairs the NEW processes with their own previous samples
+    w.do(("inc", "admitted", 11))
+    o.do(("inc", "owner_requests", 13))
+    sig = node.tick()
+    assert _increase(sig, "requests_per_s") == pytest.approx(11)
+    assert _increase(sig, "owner_requests_per_s") == pytest.approx(13)
+
+
+def test_gpu_busy_pct_is_owner_execution_time_over_the_window(node: Node) -> None:
+    o = node.start("o")
+    o.do(("obs", "guard_exec_ns", 900_000_000))
+    node.tick()
+    o.do(("obs", "guard_exec_ns", 20_000_000), ("obs", "guard_exec_ns", 4_000_000))
+    sig = node.tick()
+    assert sig["gpu_busy_pct"] == pytest.approx(min(100.0, 100 * 24e6 / (sig["window_s"] * 1e9)))  # percent
+    o.crash()
+    o = node.start("o")
+    o.do(("obs", "guard_exec_ns", 5_000_000))
+    sig = node.tick()  # restarted: all of the new owner's execution time is in this window
+    assert sig["gpu_busy_pct"] == pytest.approx(min(100.0, 100 * 5e6 / (sig["window_s"] * 1e9)))
+    sig = node.tick()
+    assert sig["gpu_busy_pct"] == 0.0  # an idle engine over a whole window: a measured 0, not a missing value
+    o.do(("obs", "guard_exec_ns", 10**12))  # more execution time than the window holds: capped at 100
+    assert node.tick()["gpu_busy_pct"] == 100.0
+
+
+def _ps(key: str, pid: int, started: int, admitted: int, hist: dict[str, object] | None = None) -> object:
+    from rvproto.runtime.windows import ProcSample
+
+    return ProcSample(key, key[0], pid, started, {"admitted": admitted}, {"exec_ns": hist} if hist else {})
+
+
+def _h(n: int, total: int, buckets: dict[str, int]) -> dict[str, object]:
+    return {"n": n, "sum": total, "max": 50, "min": 1, "b": buckets}
+
+
+def test_window_counts_each_process_against_its_own_previous_sample() -> None:
+    from rvproto.runtime.windows import Window
+
+    prev = {"w0": _ps("w0", 10, 100, 500), "w1": _ps("w1", 11, 100, 800), "w2": _ps("w2", 12, 100, 50),
+            "w4": _ps("w4", 14, 100, 70)}
+    cur = [_ps("w0", 10, 100, 520),  # the same process: +20
+           _ps("w1", 21, 250, 5),  # restarted after the previous sample (taken at 200): all 5 are new
+           _ps("w2", 12, 100, 40),  # the same process, and its counter went DOWN: a reset, so +40
+           _ps("w3", 30, 150, 99),  # first seen, but started BEFORE the previous sample: no baseline, left out
+           _ps("w4", 14, 180, 3)]  # a reused pid with a new start time: a new process, started before 200
+    win = Window(prev, 200, cur)  # type: ignore[arg-type]
+    assert win.n == 3 and win.counter("admitted") == 20 + 5 + 40
+    assert win.counter("never_counted") == 0  # processes contribute, the counter did not move: a real 0
+    assert Window({}, None, cur).counter("admitted") is None  # type: ignore[arg-type]  # no baseline at all
+    assert Window(prev, 200, []).counter("admitted") is None  # type: ignore[arg-type]  # no process left
+
+
+def test_window_histograms_reset_per_process() -> None:
+    from rvproto.runtime.windows import Window
+
+    prev = {"o0": _ps("o0", 10, 100, 0, _h(10, 1000, {"3": 10})), "o1": _ps("o1", 11, 100, 0, _h(8, 800, {"4": 8}))}
+    cur = [_ps("o0", 10, 100, 0, _h(14, 1600, {"3": 12, "5": 2})),  # +4 samples, +600 ns
+           _ps("o1", 11, 100, 0, _h(2, 90, {"2": 2}))]  # n went down: a reset, all of it is new
+    win = Window(prev, 200, cur)  # type: ignore[arg-type]
+    assert win.hist_sum("exec_ns") == 600 + 90
+    counts, n, _ = win.hist("exec_ns")  # type: ignore[misc]
+    assert n == 6 and counts[2] == 2 and counts[3] == 2 and counts[5] == 2 and counts[4] == 0
+    assert min(counts) >= 0
