+"""Reset-safe windowed increases for the node exporter's signals (M4b), with Prometheus counter semantics.
+
+Every worker / owner process keeps its own cumulative counters and histograms in its segment, and a restarted
+process starts again from zero under the same segment name. A window's increase is therefore summed PER
+PROCESS, against that process's own previous sample:
+  - the same process (pid and start time) as at the previous sample: cur - prev, or cur when cur < prev (a reset);
+  - a process that started after the previous sample (a new or restarted worker / owner): all of cur;
+  - a process with no baseline (first seen, started earlier: e.g. the exporter's own first window): nothing.
+An increase is never negative, and a signal with no contributing process is left out, never published as 0.0
+(before: a restart read as a negative rate, and an exporter restart as an idle node).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from rvproto.runtime.metrics import _NBUCKETS
+
+
+@dataclass(frozen=True, slots=True)
+class ProcSample:
+    key: str  # segment name (role + index): the same after a restart
+    role: str  # "w" | "o"
+    pid: int
+    started_ns: int  # the process's start, wall clock (segment header)
+    count: dict[str, int]
+    hist: dict[str, dict[str, object]]  # Histogram.export() format
+
+
+def _inc(cur: int, prev: int | None) -> int:
+    return cur if prev is None or cur < prev else cur - prev
+
+
+class Window:
+    """The increases of one exporter window, over the processes of one role that have a baseline."""
+
+    def __init__(self, prev: dict[str, ProcSample], prev_t_ns: int | None, cur: list[ProcSample]) -> None:
+        self.pairs: list[tuple[ProcSample | None, ProcSample]] = []
+        for c in cur:
+            p = prev.get(c.key)
+            if p is not None and (p.pid, p.started_ns) == (c.pid, c.started_ns):
+                self.pairs.append((p, c))
+            elif prev_t_ns is not None and c.started_ns >= prev_t_ns:
+                self.pairs.append((None, c))  # born inside the window: everything it counted is new
+
+    @property
+    def n(self) -> int:
+        """Processes that contribute to this window."""
+        return len(self.pairs)
+
+    def counter(self, name: str) -> int | None:
+        if not self.pairs:
+            return None
+        return sum(_inc(c.count.get(name, 0), None if p is None else p.count.get(name, 0)) for p, c in self.pairs)
+
+    def hist_sum(self, name: str) -> int | None:
+        """Increase of a histogram's value sum (e.g. total execution ns)."""
+        if not self.pairs:
+            return None
+        out = 0
+        for p, c in self.pairs:
+            h, ph = c.hist.get(name), None if p is None else p.hist.get(name)
+            if h is None:
+                continue
+            reset = ph is None or int(h["n"]) < int(ph["n"])  # type: ignore[call-overload]
+            out += int(h["sum"]) if reset else int(h["sum"]) - int(ph["sum"])  # type: ignore[call-overload,index]
+        return out
+
+    def hist(self, name: str) -> tuple[list[int], int, int] | None:
+        """(bucket counts, n, max) of the window's samples of a histogram, summed over processes."""
+        if not self.pairs:
+            return None
+        counts, n, vmax = [0] * _NBUCKETS, 0, 0
+        for p, c in self.pairs:
+            h, ph = c.hist.get(name), None if p is None else p.hist.get(name)
+            if h is None:
+                continue
+            reset = ph is None or int(h["n"]) < int(ph["n"])  # type: ignore[call-overload]
+            for k, v in h["b"].items():  # type: ignore[union-attr]
+                counts[int(k)] += v
+            if not reset:
+                for k, v in ph["b"].items():  # type: ignore[index,union-attr]
+                    counts[int(k)] -= v
+            n += int(h["n"]) - (0 if reset else int(ph["n"]))  # type: ignore[call-overload,index]
+            vmax = max(vmax, int(h["max"]))  # type: ignore[call-overload]
+        return counts, n, vmax
