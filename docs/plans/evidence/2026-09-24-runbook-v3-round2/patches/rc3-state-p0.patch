+class _RacingDB(MemDB):
+    """A writer commits and publishes right after the re-hydrator's Postgres snapshot of `ks`."""
+
+    race: Any = None
+
+    def snapshot(self, kind: str) -> tuple[Version, list[dict[str, Any]]]:
+        snap = super().snapshot(kind)
+        if kind == "ks" and self.race is not None:
+            race, self.race = self.race, None
+            race()
+        return snap
+
+
+def test_rehydrator_reads_the_store_first_so_a_racing_write_is_never_store_ahead() -> None:
+    _, r, _ = _stores()
+    db = _RacingDB()
+    w = StateWriter(db, r, K)
+    _seed(w)
+    rh = Rehydrator(db, r, w, period_ms=100, checkpoint_s=5, stale_grace_ms=0)
+    db.race = lambda: w.killswitch("org", "org-a", True)
+    assert rh.check_once() == []  # rc2 read Postgres first: "store_ahead" and a needless epoch bump
+    assert db.version("ks").epoch == 1
+
