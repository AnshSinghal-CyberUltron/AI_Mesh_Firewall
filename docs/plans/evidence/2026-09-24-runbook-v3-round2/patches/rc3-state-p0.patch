--- a/tests/functional/f_c36_fresh.py	1970-01-01 05:30:00.000000000 +0530
+++ b/tests/functional/f_c36_fresh.py	2026-09-24 19:07:53.150449313 +0530
@@ -0,0 +1,497 @@
+"""F-C36-FRESH (RC3 state layer) on real Postgres + Valkey: control-plane CLI processes, re-hydrators and gateway
+workers (`python -m rvproto.serve --worker`) of the tree under test; rc2 is the negative control (same script).
+
+  RV_TREE=<tree> RV_PG_ADMIN=<postgres dsn, db postgres> RV_VALKEY_A=<port> [RV_VALKEY_B=<port>] \\
+  RV_GUARD_TOKENIZER=<tokenizer.json> python tests/functional/f_c36_fresh.py sp1|sp1-live|sp2|lock|absent OUT_DIR
+
+Every scenario gets its own database; the store is reached through cutproxy.py (SIGUSR2 = failover). Keys (CLI seed):
+G sk-rv-org-a-0001 (valid), K sk-rv-org-b-0001 (org-b gets KILLED), R sk-rv-org-q-0001 (gets REVOKED). The guard
+and the provider are closed ports: a request that passes admission fails later with a non-admission code, so
+"served" = 200 or any code outside ADMISSION; /v1/models is identity only (200 = admitted).
+  sp1       reviewer repro_regressed_store_new_process: A replicates to B; B stops replicating; write set B (revoke R,
+            kill org-b) lands on A; the re-hydrator stops; failover to B (lost write set B); a NEW gateway starts.
+            PASS: over the hold neither the new nor the old gateway admits R or serves K; after a re-hydrator is
+            back both enforce R (401) and K (kill_switch_engaged). rc2: the new process admits R and serves K.
+  sp1-live  the same with the re-hydrator running through the failover (rc2's exposure is then a race).
+  sp2       reviewer repro_publish_pending_no_rehydrator: re-hydrator killed, then revoke R + kill org-b with the
+            writer's store path dead (ok_publish_pending). PASS: served stale for at most RV_STATE_FRESH_MS (+ one
+            refresh) after the last stamp, then only 503 with Retry-After; enforced once a re-hydrator is back.
+  lock      H7: an operator session holds rv2_version(ks) FOR UPDATE (idle in transaction), then FLUSHALL. PASS:
+            every kind re-hydrated within one round (<= 2.5 s) while the lock is held; a writer of ks behind the
+            lock ends within RV_PG_LOCK_TIMEOUT_MS + 1 s, reported "error". rc2: blocked until the release.
+  absent    two re-hydrators: one killed (no 503), then both: time to global 503; restart: time to recovery (x5).
+  pgdown    two re-hydrators, Postgres frozen 10 s (docker pause RV_PG_CONTAINER: connections hang, TCP stays up):
+            the stamps stop, so the gateways fail closed RV_STATE_FRESH_MS after the last one; recovery after thaw.
+  storeblip Valkey frozen 3.8 s (docker pause RV_VALKEY_CONTAINER; the Memorystore maintenance blip measured in
+            round 2): the 503 time of a cached key, rc2 (kill-switch ceiling 5 s) vs RC3 (stamp age 3 s). A measure.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import random
+import signal
+import socket
+import subprocess
+import sys
+import time
+from pathlib import Path
+from typing import Any
+
+import httpx
+import psycopg
+import redis
+
+TREE = Path(os.environ["RV_TREE"]).resolve()
+PY = os.environ.get("RV_PY", sys.executable)
+HERE = Path(__file__).resolve().parent
+HMAC = "f-c36-fresh-test-key-not-a-secret"
+KEYS = {"G": "sk-rv-org-a-0001", "K": "sk-rv-org-b-0001", "R": "sk-rv-org-q-0001"}
+ADMISSION = {"invalid_api_key", "kill_switch_engaged", "kill_switch_unavailable", "shared_state_unavailable",
+             "plan_unavailable", "plan_unknown_tenant", "rate_limit_exceeded", "insufficient_quota"}
+BODY = {"model": "gpt-4o-mini", "max_tokens": 8, "messages": [{"role": "user", "content": "hello"}]}
+FRESH_S = 3.0  # RV_STATE_FRESH_MS default
+STAMP = "{rv2}:stamp"
+
+
+def _port() -> int:
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return int(s.getsockname()[1])
+
+
+class Stack:
+    def __init__(self, out: Path, name: str, *, failover: bool = False) -> None:
+        self.out, self.procs, self.gw = out, {}, {}
+        out.mkdir(parents=True, exist_ok=True)
+        self.va = int(os.environ["RV_VALKEY_A"])
+        self.vb = int(os.environ["RV_VALKEY_B"]) if failover else None
+        self.proxy_port, pidfile = _port(), out / "proxy.pid"
+        pidfile.unlink(missing_ok=True)
+        self.start("proxy", [PY, str(HERE / "cutproxy.py"), str(self.proxy_port), str(self.va), str(pidfile), "0",
+                             *([str(self.vb)] if self.vb else [])])
+        while not pidfile.exists() or not pidfile.read_text():
+            time.sleep(0.05)
+        self.proxy_pid = int(pidfile.read_text())
+        admin = os.environ["RV_PG_ADMIN"]
+        self.db = f"f_fresh_{name}_{os.getpid()}_{int(time.time())}"
+        with psycopg.connect(admin, autocommit=True) as c:
+            c.execute(f"CREATE DATABASE {self.db}")
+        self.dsn = admin.rsplit("/", 1)[0] + "/" + self.db
+        self.env = {"PYTHONPATH": str(TREE), "RV_DATABASE_URL": self.dsn, "RV_STATE_HMAC_KEY": HMAC,
+                    "RV_REDIS_URL": f"redis://127.0.0.1:{self.proxy_port}/0"}
+        self.direct = redis.Redis(port=self.va)
+        self.tag = f"ff{os.getpid()}"
+
+    def start(self, name: str, args: list[str], **env: str) -> subprocess.Popen[bytes]:
+        log = open(self.out / f"{name}.log", "ab")  # noqa: SIM115
+        p = subprocess.Popen(args, cwd=TREE, env={**os.environ, **getattr(self, "env", {}), **env}, stdout=log,
+                             stderr=subprocess.STDOUT)
+        self.procs[name] = p
+        return p
+
+    def kill(self, name: str) -> float:
+        self.procs[name].send_signal(signal.SIGKILL)
+        self.procs[name].wait()
+        return time.time()
+
+    def cli(self, *args: str, **env: str) -> tuple[int, dict[str, Any], float]:
+        t0 = time.time()
+        p = subprocess.run([PY, "-m", "rvproto.control", *args], cwd=TREE, env={**os.environ, **self.env, **env},
+                           capture_output=True, text=True, timeout=120)
+        with open(self.out / "cli.log", "a") as f:
+            f.write(json.dumps({"args": list(args[:1]) + ["<key>" if a.startswith("sk-") else a for a in args[1:]],
+                                "rc": p.returncode}) + "\n" + p.stderr[-4000:] + "\n")
+        lines = [ln for ln in p.stdout.splitlines() if ln.startswith("{")]
+        return p.returncode, (json.loads(lines[-1]) if lines else {}), time.time() - t0
+
+    def rehydrator(self, name: str) -> None:
+        self.start(name, [PY, "-m", "rvproto.control", "rehydrate"], RV_REHYDRATOR_ID=name)
+
+    def gateway(self, name: str, idx: int) -> int:
+        port = _port()
+        self.start(name, [PY, "-m", "rvproto.serve", "--worker"], RV_HOST="127.0.0.1", RV_PORT=str(port),
+                   RV_FIX_C36="on", RV_STORE_TIMEOUT_MS="200", RV_GUARD_TOPOLOGY="remote", RV_GUARD_DISCOVERY="static",
+                   RV_GUARD_OWNER_ADDRS=f"127.0.0.1:{_port()}", RV_PROVIDER_URL=f"http://127.0.0.1:{_port()}",
+                   RV_GUARD_TOKENIZER=os.environ["RV_GUARD_TOKENIZER"], RV_DRAIN_ACCEPT_S="0", RV_EXPORTER_PORT="0",
+                   RV_WORKER_INDEX=str(idx), RV_METRICS_TAG=f"{self.tag}{idx}")
+        end = time.monotonic() + 60
+        while True:
+            try:
+                if httpx.get(f"http://127.0.0.1:{port}/healthz", timeout=2).status_code == 200:
+                    break
+            except httpx.TransportError:
+                pass
+            assert self.procs[name].poll() is None and time.monotonic() < end, f"{name} did not start"
+            time.sleep(0.1)
+        self.gw[name] = port
+        return port
+
+    def close(self) -> None:
+        for p in self.procs.values():
+            if p.poll() is None:
+                p.send_signal(signal.SIGKILL)
+                p.wait()
+        for p in Path("/dev/shm").glob(f"*{self.tag}*"):
+            p.unlink(missing_ok=True)
+        with psycopg.connect(os.environ["RV_PG_ADMIN"], autocommit=True) as c:
+            c.execute(f"DROP DATABASE IF EXISTS {self.db} WITH (FORCE)")
+
+
+def probe(port: int, what: str, key: str) -> dict[str, Any]:
+    t = time.time()
+    try:
+        if what == "models":
+            r = httpx.get(f"http://127.0.0.1:{port}/v1/models", headers={"authorization": f"Bearer {key}"}, timeout=5)
+        else:
+            r = httpx.post(f"http://127.0.0.1:{port}/v1/chat/completions", json=BODY, timeout=5,
+                           headers={"authorization": f"Bearer {key}"})
+        code = ""
+        if r.status_code != 200:
+            try:
+                code = r.json()["error"]["code"]
+            except (ValueError, KeyError, TypeError):
+                code = r.text[:40]
+        out = {"t": t, "status": r.status_code, "code": code, "retry_after": r.headers.get("retry-after")}
+    except httpx.TransportError as exc:
+        out = {"t": t, "status": 0, "code": type(exc).__name__, "retry_after": None}
+    out["served"] = out["status"] == 200 or (out["status"] != 0 and out["code"] not in ADMISSION)
+    return out
+
+
+def state(port: int) -> dict[str, Any]:
+    b = httpx.get(f"http://127.0.0.1:{port}/readyz", timeout=5).json()
+    return {"plans_fresh": b.get("plans_fresh"), "killswitch": b.get("killswitch")}
+
+
+def run_probes(st: Stack, gws: list[str], seconds: float, rec: list[dict[str, Any]], phase: str,
+               plan: tuple[tuple[str, str], ...] = (("models", "R"), ("chat", "K"), ("chat", "G"))) -> None:
+    end = time.time() + seconds
+    while time.time() < end:
+        for gw in gws:
+            for what, k in plan:
+                rec.append({"phase": phase, "gw": gw, "what": what, "key": k, **probe(st.gw[gw], what, KEYS[k])})
+        time.sleep(0.02)
+
+
+def wait_for(cond: Any, seconds: float) -> float | None:
+    t0, end = time.time(), time.time() + seconds
+    while time.time() < end:
+        if cond():
+            return time.time() - t0
+        time.sleep(0.05)
+    return None
+
+
+def enforced(st: Stack, gw: str) -> bool:
+    return (probe(st.gw[gw], "models", KEYS["R"])["status"] == 401
+            and probe(st.gw[gw], "chat", KEYS["K"])["code"] == "kill_switch_engaged"
+            and probe(st.gw[gw], "chat", KEYS["G"])["served"])
+
+
+def last_stamp(st: Stack) -> float | None:
+    raw = st.direct.get(STAMP)
+    return None if raw is None else json.loads(raw)["verified_at_ms"] / 1000.0
+
+
+def served(rec: list[dict[str, Any]], **match: Any) -> int:
+    return sum(1 for x in rec if x["served"] and all(x[k] == v for k, v in match.items()))
+
+
+def admitted_r(rec: list[dict[str, Any]], **match: Any) -> int:
+    return sum(1 for x in rec if x["what"] == "models" and x["key"] == "R" and x["status"] == 200
+               and all(x[k] == v for k, v in match.items()))
+
+
+def boot(st: Stack, gws: dict[str, int], rehydrators: tuple[str, ...]) -> dict[str, Any]:
+    rc, seeded, _ = st.cli("init-db")
+    assert rc == 0, "init-db failed"
+    rc, seeded, _ = st.cli("seed")
+    assert rc == 0, "seed failed"
+    for name in rehydrators:
+        st.rehydrator(name)
+    for name, idx in gws.items():
+        st.gateway(name, idx)
+    ready = {gw: wait_for(lambda gw=gw: state(st.gw[gw]) == {"plans_fresh": True, "killswitch": "ok"}
+                          and probe(st.gw[gw], "chat", KEYS["G"])["served"], 20) for gw in gws}
+    assert all(v is not None for v in ready.values()), f"gateways not serving: {ready}"
+    return {"ready_s": ready}
+
+
+def sp1(st: Stack, live: bool) -> dict[str, Any]:
+    ra, rb = st.direct, redis.Redis(port=st.vb)
+    rb.replicaof("no", "one")
+    rb.flushall()
+    ra.flushall()
+    rb.replicaof("127.0.0.1", st.va)
+    assert wait_for(lambda: rb.info("replication").get("master_link_status") == "up", 15) is not None
+    info = boot(st, {"gw-old": 0}, ("rh-1",))
+    time.sleep(1.5)  # a few stamps replicate
+    def synced() -> bool:
+        rep = rb.info("replication")
+        return int(rep.get("slave_repl_offset", rep.get("replica_repl_offset", -1))) >= int(
+            ra.info("replication")["master_repl_offset"])
+
+    assert wait_for(synced, 5) is not None
+    rb.replicaof("no", "one")  # B stops replicating: it keeps write set A (and the stamps so far)
+    outs = [st.cli("key-revoke", KEYS["R"])[1].get("status"), st.cli("killswitch", "org", "org-b", "on")[1].get("status")]
+    info["write_set_b"] = outs
+    info["old_applied_s"] = wait_for(lambda: enforced(st, "gw-old"), 5)
+    if not live:
+        st.kill("rh-1")
+    t_fail = time.time()
+    os.kill(st.proxy_pid, signal.SIGUSR2)  # failover: the endpoint now reaches B, which lost write set B
+    st.gateway("gw-new", 1)  # a recreated gateway: a NEW process after the failover
+    info["new_started_after_failover_s"] = round(time.time() - t_fail, 2)
+    rec: list[dict[str, Any]] = []
+    run_probes(st, ["gw-new", "gw-old"], 8.0, rec, "failover")
+    if not live:
+        st.rehydrator("rh-2")
+    t_back = time.time()
+    conv = {gw: wait_for(lambda gw=gw: enforced(st, gw), 10) for gw in ("gw-new", "gw-old")}
+    run_probes(st, ["gw-new", "gw-old"], 2.0, rec, "after")
+    info.update({
+        "hold_s": 8.0, "rehydrator_during_failover": live, "probes": len(rec),
+        "new_R_admitted": admitted_r(rec, gw="gw-new", phase="failover"),
+        "new_K_served": served(rec, gw="gw-new", key="K", phase="failover"),
+        "old_R_admitted": admitted_r(rec, gw="gw-old", phase="failover"),
+        "old_K_served": served(rec, gw="gw-old", key="K", phase="failover"),
+        "new_codes": _codes(rec, gw="gw-new", phase="failover"),
+        "converged_s_after_rehydrator": conv, "rehydrator_back_at": t_back,
+        "after_R_admitted": admitted_r(rec, phase="after"), "after_K_served": served(rec, key="K", phase="after")})
+    info["pass"] = (info["new_R_admitted"] == 0 and info["new_K_served"] == 0 and info["old_R_admitted"] == 0
+                    and info["old_K_served"] == 0 and all(v is not None for v in conv.values())
+                    and info["after_R_admitted"] == 0 and info["after_K_served"] == 0)
+    _dump(st, rec)
+    return info
+
+
+def _codes(rec: list[dict[str, Any]], **match: Any) -> dict[str, int]:
+    out: dict[str, int] = {}
+    for x in rec:
+        if all(x[k] == v for k, v in match.items()):
+            key = f"{x['what']}:{x['key']}:{x['status']}:{x['code'] if not x['served'] else 'served'}"
+            out[key] = out.get(key, 0) + 1
+    return dict(sorted(out.items()))
+
+
+def _dump(st: Stack, rec: list[dict[str, Any]]) -> None:
+    with open(st.out / "probes.jsonl", "w") as f:
+        for x in rec:
+            f.write(json.dumps(x) + "\n")
+
+
+def sp2(st: Stack) -> dict[str, Any]:
+    st.direct.flushall()
+    info = boot(st, {"gw-0": 0}, ("rh-1",))
+    t_kill = st.kill("rh-1")
+    stamp = last_stamp(st)
+    dead = "redis://127.0.0.1:1/0"  # the writer's store path is down (the gateways' is not)
+    info["writer"] = [st.cli("key-revoke", KEYS["R"], RV_REDIS_URL=dead)[:2],
+                      st.cli("killswitch", "org", "org-b", "on", RV_REDIS_URL=dead)[:2]]
+    t_writes = time.time()
+    rec: list[dict[str, Any]] = []
+    run_probes(st, ["gw-0"], 10.0, rec, "no-rehydrator")
+    bad = [x for x in rec if x["served"] and x["key"] in ("R", "K")]
+    closed = [x for x in rec if x["status"] == 503 and x["code"] in ("kill_switch_unavailable", "shared_state_unavailable")]
+    first_closed = min((x["t"] for x in closed), default=None)
+    info.update({"rehydrator_killed_at": t_kill, "last_stamp_verified_at": stamp, "writes_done_at": t_writes,
+                 "stale_served_R_or_K": len(bad), "last_stale_served_after_writes_s":
+                     round(max(x["t"] for x in bad) - t_writes, 3) if bad else None,
+                 "first_fail_closed_after_writes_s": round(first_closed - t_writes, 3) if first_closed else None,
+                 "first_fail_closed_after_stamp_s": round(first_closed - stamp, 3) if first_closed and stamp else None,
+                 "served_after_fail_closed": sum(1 for x in rec if first_closed and x["t"] > first_closed + 0.05
+                                                 and (x["served"] or x["status"] == 200)),
+                 "retry_after_on_fail_closed": sorted({str(x["retry_after"]) for x in closed}),
+                 "codes": _codes(rec)})
+    st.rehydrator("rh-2")
+    info["enforced_s_after_rehydrator"] = wait_for(lambda: enforced(st, "gw-0"), 10)
+    info["pass"] = (first_closed is not None and stamp is not None and first_closed - stamp <= FRESH_S + 0.6
+                    and info["served_after_fail_closed"] == 0 and "None" not in info["retry_after_on_fail_closed"]
+                    and info["enforced_s_after_rehydrator"] is not None)
+    _dump(st, rec)
+    return info
+
+
+def lock(st: Stack) -> dict[str, Any]:
+    st.direct.flushall()
+    info = boot(st, {"gw-0": 0}, ("rh-1",))
+    info["session_bounds"] = _session_bounds(st)
+    hold = psycopg.connect(st.dsn)  # an operator's psql session: no timeouts, then idle in transaction
+    hold.execute("SELECT * FROM rv2_version WHERE kind = 'ks' FOR UPDATE")
+    t0 = time.time()
+    writer = subprocess.Popen([PY, "-m", "rvproto.control", "killswitch", "model", "gpt-x", "on"], cwd=TREE,
+                              env={**os.environ, **st.env}, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
+    st.direct.flushall()
+    t_flush = time.time()
+    kinds = ("plan", "key", "ks", "budget")
+    restored: dict[str, float | None] = {}
+    end = t_flush + 12.0
+    rec: list[dict[str, Any]] = []
+    writer_end: float | None = None
+    while time.time() < end:
+        if writer_end is None and writer.poll() is not None:
+            writer_end = time.time()
+        for k in kinds:
+            if k not in restored and st.direct.get("{rv2}:meta:" + k) is not None:
+                restored[k] = round(time.time() - t_flush, 3)
+        rec.append({"phase": "locked", "gw": "gw-0", "what": "chat", "key": "G", **probe(st.gw["gw-0"], "chat", KEYS["G"])})
+        time.sleep(0.05)
+    writer_done = writer_end is not None or writer.poll() is not None
+    hold.rollback()
+    t_release = time.time()
+    hold.close()
+    out, _ = writer.communicate(timeout=30)
+    t_writer = writer_end or time.time()
+    status = next((json.loads(ln) for ln in out.splitlines() if ln.startswith("{")), {})
+    refused = [x["t"] - t_flush for x in rec if x["t"] > t_flush and not x["served"]]
+    info.update({"restored_s_after_flush": {k: restored.get(k) for k in kinds},
+                 "g_refused": len(refused), "g_last_refused_s_after_flush": round(max(refused), 3) if refused else None,
+                 "writer_ended_while_locked": writer_done, "writer_status": status.get("status"),
+                 "writer_error": (status.get("error") or "")[:120], "writer_rc": writer.returncode,
+                 "writer_took_s": round(t_writer - t0, 2), "lock_held_s": round(t_release - t0, 2),
+                 "codes": _codes(rec)})
+    info["pass"] = (all(v is not None and v <= 2.5 for v in info["restored_s_after_flush"].values())
+                    and (not refused or max(refused) <= 3.5) and writer_done and info["writer_status"] == "error"
+                    and info["writer_took_s"] <= 2.0 + 1.5)
+    _dump(st, rec)
+    return info
+
+
+def _session_bounds(st: Stack) -> dict[str, str]:
+    code = ("import json, os\nfrom rvproto.control.db import PgDB\nc = PgDB(os.environ['RV_DATABASE_URL'])._conn()\n"
+            "print(json.dumps({g: c.execute(f'SHOW {g}').fetchone()[0] for g in ('lock_timeout', 'statement_timeout', "
+            "'idle_in_transaction_session_timeout', 'tcp_user_timeout')}))")
+    p = subprocess.run([PY, "-c", code], cwd=TREE, env={**os.environ, **st.env}, capture_output=True, text=True)
+    return json.loads(p.stdout) if p.returncode == 0 else {"error": p.stderr[-200:]}
+
+
+def recovered(st: Stack, gws: list[str], t0: float, seconds: float) -> dict[str, float | None]:
+    """Seconds from t0 to each gateway's first served G (probed round-robin, so each is measured on its own)."""
+    first: dict[str, float | None] = {gw: None for gw in gws}
+    end = time.time() + seconds
+    while time.time() < end and any(v is None for v in first.values()):
+        for gw in gws:
+            if first[gw] is None and probe(st.gw[gw], "chat", KEYS["G"])["served"]:
+                first[gw] = round(time.time() - t0, 3)
+        time.sleep(0.01)
+    return first
+
+
+def absent(st: Stack, reps: int = 5) -> dict[str, Any]:
+    st.direct.flushall()
+    info = boot(st, {"gw-0": 0, "gw-1": 1}, ("rh-1", "rh-2"))
+    gws = ["gw-0", "gw-1"]
+    rec: list[dict[str, Any]] = []
+    st.kill("rh-1")  # one of two re-hydrators lost: nothing may fail closed
+    run_probes(st, gws, 5.0, rec, "one-rehydrator", (("chat", "G"),))
+    info["one_rehydrator_503s"] = sum(1 for x in rec if x["status"] == 503)
+    st.rehydrator("rh-1")
+    runs = []
+    for i in range(reps):
+        time.sleep(3.0 + random.random())  # a random phase against the re-hydrators' rounds
+        stamp = last_stamp(st)
+        t_kill = max(st.kill("rh-1"), st.kill("rh-2"))
+        stamp = last_stamp(st) or stamp
+        r: list[dict[str, Any]] = []
+        end = t_kill + 8.0
+        while time.time() < end:
+            run_probes(st, gws, 0.001, r, f"absent-{i}", (("chat", "G"),))
+        first = {gw: min((x["t"] for x in r if x["gw"] == gw and x["status"] == 503), default=None) for gw in gws}
+        last_served = max((x["t"] for x in r if x["served"]), default=None)
+        t_back = time.time()
+        st.rehydrator("rh-1")
+        st.rehydrator("rh-2")
+        back = recovered(st, gws, t_back, 10)
+        runs.append({
+            "stamp_age_at_kill_s": round(t_kill - stamp, 3) if stamp else None,
+            "first_503_after_kill_s": {g: round(v - t_kill, 3) if v else None for g, v in first.items()},
+            "first_503_after_last_stamp_s": {g: round(v - stamp, 3) if v and stamp else None for g, v in first.items()},
+            "global_503_after_kill_s": round(last_served - t_kill, 3) if last_served else None,
+            "served_after_first_503": sum(1 for x in r if x["served"] and all(first.values())
+                                          and x["t"] > max(v for v in first.values() if v) + 0.05),
+            "retry_after": sorted({str(x["retry_after"]) for x in r if x["status"] == 503}),
+            "codes": _codes(r), "recovered_s_after_restart": back, "restarted_at": t_back})
+        rec.extend(r)
+    info["runs"] = runs
+    info["pass"] = info["one_rehydrator_503s"] == 0 and all(
+        all(v is not None and v <= FRESH_S + 0.6 for v in x["first_503_after_last_stamp_s"].values())
+        and x["served_after_first_503"] == 0 and all(v is not None for v in x["recovered_s_after_restart"].values())
+        for x in runs)
+    _dump(st, rec)
+    return info
+
+
+def storeblip(st: Stack) -> dict[str, Any]:
+    st.direct.flushall()
+    info = boot(st, {"gw-0": 0}, ("rh-1", "rh-2"))
+    rec: list[dict[str, Any]] = []
+    run_probes(st, ["gw-0"], 2.0, rec, "before", (("chat", "G"),))
+    stamp = last_stamp(st)
+    subprocess.run(["docker", "pause", os.environ["RV_VALKEY_CONTAINER"]], check=True, capture_output=True)
+    t_down = time.time()
+    try:
+        run_probes(st, ["gw-0"], 3.8, rec, "store-frozen", (("chat", "G"),))
+    finally:
+        subprocess.run(["docker", "unpause", os.environ["RV_VALKEY_CONTAINER"]], check=True, capture_output=True)
+    t_up = time.time()
+    run_probes(st, ["gw-0"], 4.0, rec, "after", (("chat", "G"),))
+    refused = [x for x in rec if x["t"] >= t_down and not x["served"]]
+    info.update({"store_frozen_s": round(t_up - t_down, 2),
+                 "stamp_age_at_freeze_s": round(t_down - stamp, 3) if stamp else None,
+                 "first_refused_after_freeze_s": round(refused[0]["t"] - t_down, 3) if refused else None,
+                 "last_refused_after_thaw_s": round(refused[-1]["t"] - t_up, 3) if refused else None,
+                 "refused_span_s": round(refused[-1]["t"] - refused[0]["t"], 3) if refused else 0.0,
+                 "codes_frozen": _codes(rec, phase="store-frozen"), "codes_after": _codes(rec, phase="after")})
+    info["pass"] = True  # a measurement (the trade-off), not a correctness check
+    _dump(st, rec)
+    return info
+
+
+def pgdown(st: Stack) -> dict[str, Any]:
+    st.direct.flushall()
+    info = boot(st, {"gw-0": 0}, ("rh-1", "rh-2"))
+    rec: list[dict[str, Any]] = []
+    run_probes(st, ["gw-0"], 2.0, rec, "before", (("chat", "G"),))
+    stamp = last_stamp(st)
+    pg = os.environ["RV_PG_CONTAINER"]
+    subprocess.run(["docker", "pause", pg], check=True, capture_output=True)
+    t_down = time.time()
+    try:
+        run_probes(st, ["gw-0"], 10.0, rec, "pg-frozen", (("chat", "G"),))
+    finally:
+        subprocess.run(["docker", "unpause", pg], check=True, capture_output=True)
+    t_up = time.time()
+    back = recovered(st, ["gw-0"], t_up, 20)
+    run_probes(st, ["gw-0"], 2.0, rec, "after", (("chat", "G"),))
+    first = min((x["t"] for x in rec if x["status"] == 503), default=None)
+    info.update({"pg_frozen_s": round(t_up - t_down, 2),
+                 "stamp_age_at_freeze_s": round(t_down - stamp, 3) if stamp else None,
+                 "first_503_after_freeze_s": round(first - t_down, 3) if first else None,
+                 "first_503_after_last_stamp_s": round(first - stamp, 3) if first and stamp else None,
+                 "recovered_s_after_thaw": back, "codes_frozen": _codes(rec, phase="pg-frozen"),
+                 "codes_after": _codes(rec, phase="after")})
+    info["pass"] = (first is not None and stamp is not None and first - stamp <= FRESH_S + 0.6 and back["gw-0"] is not None
+                    and back["gw-0"] <= 3.0)
+    _dump(st, rec)
+    return info
+
+
+def main() -> int:
+    scenario, out = sys.argv[1], Path(sys.argv[2])
+    st = Stack(out, scenario.replace("-", "_"), failover=scenario.startswith("sp1"))
+    try:
+        info = {"sp1": lambda: sp1(st, False), "sp1-live": lambda: sp1(st, True), "sp2": lambda: sp2(st),
+                "lock": lambda: lock(st), "absent": lambda: absent(st), "pgdown": lambda: pgdown(st),
+                "storeblip": lambda: storeblip(st)}[scenario]()
+    finally:
+        st.close()
+    info = {"scenario": scenario, "tree": str(TREE), **info}
+    (out / "summary.json").write_text(json.dumps(info, indent=1, default=str))
+    print(json.dumps({"scenario": scenario, "tree": TREE.name, "pass": info["pass"]}))
+    return 0 if info["pass"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff -ruN a/tests/unit/test_c36_freshness.py b/tests/unit/test_c36_freshness.py
--- a/tests/unit/test_c36_freshness.py	1970-01-01 05:30:00.000000000 +0530
+++ b/tests/unit/test_c36_freshness.py	2026-09-24 19:07:53.156963337 +0530
@@ -0,0 +1,417 @@
+"""RC3 state layer: signed freshness stamp (SP1/SP2), re-hydrator isolation (H7), single-flight plan reconcile (SP6).
+
+The reviewer's reproductions (evidence/reviewer-state-propagation/r2pass1) run here on fakeredis + the in-memory
+Postgres twin, each with its rc2 negative control (readers without a stamp); tests/functional/f_c36_fresh.py runs
+them against real Postgres + Valkey processes.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import time
+from typing import Any
+
+import fakeredis
+import orjson
+import pytest
+
+from rvproto.admit.admission import Admission
+from rvproto.admit.quota import Gcra, TokenLease
+from rvproto.admit.state_v2 import VersionedIdentity, VersionedKillSwitch
+from rvproto.control.db import MemDB, PgDB
+from rvproto.control.rehydrate import Rehydrator
+from rvproto.control.writer import StateWriter, key_hash
+from rvproto.domain.plan import PlanUnavailable
+from rvproto.domain.request import ErrorSpec
+from rvproto.plan.fixtures import tenants
+from rvproto.plan.snapshot_v2 import VersionedPlanSnapshot
+from rvproto.runtime.metrics import Registry
+from rvproto.runtime.store import K2_META, K2_PLAN, K2_STAMP
+from rvproto.runtime.versioned import (
+    ZERO,
+    StampView,
+    StoreDataUnavailable,
+    Version,
+    make_meta,
+    make_stamp,
+    verify_stamp,
+)
+
+K = b"test-hmac-key-not-a-secret"
+KEY_R, KEY_G = "sk-fresh-revoked-R", "sk-fresh-valid-G"
+MODEL = "gpt-4o-mini"
+
+
+def _stores() -> tuple[fakeredis.FakeServer, fakeredis.FakeRedis, fakeredis.aioredis.FakeRedis]:
+    server = fakeredis.FakeServer()
+    return server, fakeredis.FakeRedis(server=server), fakeredis.aioredis.FakeRedis(server=server)
+
+
+def _seed(w: StateWriter) -> None:
+    w.killswitch("global", None, False)
+    w.killswitch("org", "org-a", False)
+    w.key_add(KEY_R, "org-a", key_id="k-R", rate=1e6, burst=1e6)
+    w.key_add(KEY_G, "org-b", key_id="k-G", rate=1e6, burst=1e6)
+    for org, doc in tenants().items():
+        w.plan_set(doc)
+        w.budget_set(org, 10**9)
+
+
+class _Gateway:
+    """One gateway worker's C36 readers + admission; stamp=None is rc2 (no freshness)."""
+
+    def __init__(self, ar: Any, *, fresh_ms: float | None = 3000, clock: Any = time.time) -> None:
+        self.stamp = None if fresh_ms is None else StampView(K, fresh_ms=fresh_ms, clock=clock)
+        self.ident = VersionedIdentity(ar, K, stamp=self.stamp)
+        self.ks = VersionedKillSwitch(ar, Registry(0), K, refresh_ms=100, stale_ms=5000, identity=self.ident)
+        self.plans = VersionedPlanSnapshot(ar, Registry(0), K, reconcile_ms=100, stale_ms=5000, stamp=self.stamp)
+        self.adm = Admission(self.ident, self.ks, Gcra(), TokenLease(ar, Registry(0), chunk_tokens=100, durable=True),
+                             2.0)
+
+    async def refresh(self) -> None:
+        for step in (self.ks.refresh_once, self.plans.load_all if not self.plans.loaded else self.plans.reconcile):
+            try:
+                await step()
+            except StoreDataUnavailable:
+                pass  # the RAM snapshot is kept (it ages)
+
+    async def outcome(self, api_key: str) -> str:
+        """'200' | '401' | '503 <code>' as the edge would answer (admission only)."""
+        self.ident._cache.clear()  # every probe is a cache miss: the store answers
+        got = await self.adm.admit(api_key, 10, MODEL)
+        if isinstance(got, ErrorSpec):
+            return f"{got.status} {got.code}" if got.status == 503 else str(got.status)
+        return "200"
+
+    def ready(self) -> bool:  # edge/ops.readiness without the guard: plans fresh and kill switch not stale
+        return self.plans.fresh() and self.ks.state() != "stale"
+
+
+def _dump(r: fakeredis.FakeRedis) -> dict[bytes, bytes]:
+    return {k: r.dump(k) for k in r.scan_iter("{rv2}:*")}
+
+
+def _restore(r: fakeredis.FakeRedis, snap: dict[bytes, bytes]) -> None:
+    r.flushall()
+    for k, v in snap.items():
+        r.restore(k, 0, v, replace=True)
+
+
+def test_stamp_is_signed_and_rejects_tampering() -> None:
+    now = time.time()
+    raw = orjson.dumps(make_stamp(K, now, {"ks": Version(1, 3), "key": Version(2, 0)}, "rh-a"))
+    s = verify_stamp(K, raw)
+    assert s.versions == {"ks": Version(1, 3), "key": Version(2, 0)} and s.by == "rh-a" and abs(s.verified_at - now) < 0.002
+    for field, value in (("verified_at_ms", int(now * 1000) + 60_000), ("versions", {"ks": [9, 9]}), ("by", "x")):
+        forged = dict(orjson.loads(raw), **{field: value})
+        with pytest.raises(StoreDataUnavailable, match="signature"):
+            verify_stamp(K, orjson.dumps(forged))
+    with pytest.raises(StoreDataUnavailable, match="signature"):
+        verify_stamp(b"another-key", raw)
+    for junk in (b"{", b"[]", orjson.dumps(make_meta(K, "ks", Version(1, 1), [])), orjson.dumps({"versions": 3})):
+        with pytest.raises(StoreDataUnavailable):
+            verify_stamp(K, junk)
+
+
+def test_stamp_view_floors_only_rise_and_freshness_is_bounded_both_ways() -> None:
+    v = StampView(K, fresh_ms=3000, started_at=100.0)
+    assert not v.fresh(now=100.0) and "no freshness stamp" in v.unverified()
+    assert v.observe(orjson.dumps(make_stamp(K, 99.5, {"ks": Version(1, 3)}, "a")))
+    assert v.floor("ks", ZERO) == Version(1, 3) and v.floor("plan", Version(1, 1)) == Version(1, 1)
+    assert not v.fresh(now=100.2) and "started after this process" in v.unverified()  # pre-start round
+    assert v.observe(orjson.dumps(make_stamp(K, 100.5, {"ks": Version(1, 2)}, "b")))  # slower 2nd re-hydrator
+    assert v.floor("ks", ZERO) == Version(1, 3) and v.verified_at == 100.5 and v.by == "b"
+    assert v.fresh(now=101.0) and v.fresh(now=103.5) and not v.fresh(now=103.6)
+    assert v.observe(orjson.dumps(make_stamp(K, 100.1, {"ks": Version(1, 4)}, "c")))  # older round, newer version
+    assert v.verified_at == 100.5 and v.floor("ks", ZERO) == Version(1, 4)
+    assert not v.observe(None) and v.invalid == 0
+    assert not v.observe(orjson.dumps(make_stamp(b"forger", 105.0, {"ks": Version(9, 9)}, "x")))
+    assert v.invalid == 1 and v.verified_at == 100.5 and v.floor("ks", ZERO) == Version(1, 4)
+    skew = StampView(K, fresh_ms=3000, started_at=100.0)
+    skew.observe(orjson.dumps(make_stamp(K, 110.0, {}, "a")))  # 9.5 s in this host's future: a clock problem
+    assert not skew.fresh(now=100.5) and skew.fresh(now=108.0)
+    assert StampView(K, fresh_ms=0).fresh()  # RV_STATE_FRESH_MS=0: not enforced (rc2)
+
+
+class _FlakyDB(MemDB):
+    """Postgres answers every kind but `broken` (a statement timeout / lock timeout on that kind only)."""
+
+    broken: str | None = None
+
+    def snapshot(self, kind: str) -> tuple[Version, list[dict[str, Any]]]:
+        if kind == self.broken:
+            raise ConnectionError(f"injected: canceling statement due to lock timeout ({kind})")
+        return super().snapshot(kind)
+
+
+def test_rehydrator_stamps_only_fully_verified_rounds_and_one_kind_never_stalls_the_others() -> None:
+    _, r, _ = _stores()
+    db = _FlakyDB()
+    w = StateWriter(db, r, K)
+    _seed(w)
+    rh = Rehydrator(db, r, w, period_ms=100, checkpoint_s=5, name="rh-a")
+    r.flushall()
+    db.broken = "ks"
+    events = rh.check_once()
+    assert {e["kind"] for e in events} == {"plan", "key", "budget"}  # rc2 stalled here (FOR SHARE, no timeout)
+    assert r.get(K2_STAMP) is None and rh.stamped is None  # not every kind verified: no stamp
+    db.broken = None
+    t0 = time.time()
+    assert [e["kind"] for e in rh.check_once()] == ["ks"]
+    s = verify_stamp(K, r.get(K2_STAMP))
+    assert s.by == "rh-a" and t0 - 0.001 <= s.verified_at <= time.time()
+    assert s.versions == {kind: db.version(kind) for kind in ("plan", "key", "ks", "budget")}
+    assert rh.check_once() == [] and verify_stamp(K, r.get(K2_STAMP)).verified_at >= s.verified_at  # heartbeat
+
+
+def test_two_rehydrators_never_replace_a_newer_stamp() -> None:
+    _, r, _ = _stores()
+    db = MemDB()
+    w = StateWriter(db, r, K)
+    _seed(w)
+    a = Rehydrator(db, r, w, period_ms=100, checkpoint_s=5, name="rh-a")
+    b = Rehydrator(db, r, w, period_ms=100, checkpoint_s=5, name="rh-b")
+    a_started = time.time() - 0.5  # rh-a's round started earlier and finishes last
+    b.check_once()
+    newer = r.get(K2_STAMP)
+    a._stamp(a_started, {k: db.version(k) for k in ("plan", "key", "ks", "budget")})
+    assert r.get(K2_STAMP) == newer and verify_stamp(K, newer).by == "rh-b"
+    r.set(K2_STAMP, orjson.dumps(make_stamp(b"forger", time.time() + 60, {}, "x")))  # forged: overwritten
+    a.check_once()
+    assert verify_stamp(K, r.get(K2_STAMP)).by == "rh-a"
+
+
+async def test_sp1_new_process_after_failover_to_lagging_replica_serves_nothing_until_reverified() -> None:
+    """repro_regressed_store_new_process: write set A, a replica snapshot, write set B (revoke R, kill org-a),
+    failover to the replica. rc2: a NEW process admits R and serves the killed org. RC3: it answers 503 until
+    a re-hydrator round that started after it has republished B; then R is 401 and org-a is killed."""
+    _, r, ar = _stores()
+    db = MemDB()
+    w = StateWriter(db, r, K)
+    _seed(w)
+    old = _Gateway(ar)
+    rh = Rehydrator(db, r, w, period_ms=100, checkpoint_s=5, stale_grace_ms=0, name="rh-a")
+    rh.check_once()
+    lagging = _dump(r)  # what the replica has: write set A + the stamp of that round
+    w.key_revoke(KEY_R)
+    w.killswitch("org", "org-a", True)
+    rh.check_once()
+    await old.refresh()
+    assert await old.outcome(KEY_R) == "401" and await old.outcome(KEY_G) == "200" and old.ks.org_killed("org-a")
+    _restore(r, lagging)  # failover: the promoted replica lost write set B
+    time.sleep(0.01)  # the new processes start after the failover (as recreated gateways do)
+    new, rc2 = _Gateway(ar), _Gateway(ar, fresh_ms=None)
+    for gw in (old, new, rc2):
+        await gw.refresh()
+    assert await rc2.outcome(KEY_R) == "200" and not rc2.ks.org_killed("org-a")  # the rc2 defect (SP1)
+    assert await old.outcome(KEY_R) == "503 shared_state_unavailable" and old.ks.org_killed("org-a")
+    for key in (KEY_R, KEY_G):  # the new process refuses everything: never 200 for R, never serves org-a
+        assert await new.outcome(key) == "503 kill_switch_unavailable"
+    assert not new.ready() and isinstance(new.plans.get("org-a"), PlanUnavailable)
+    time.sleep(0.01)
+    assert {e["kind"] for e in rh.check_once()} >= {"key", "ks"}  # the re-hydrator restores write set B
+    for gw in (old, new, rc2):
+        await gw.refresh()
+    for gw in (old, new):
+        assert gw.ready() and await gw.outcome(KEY_R) == "401" and await gw.outcome(KEY_G) == "200"
+        assert gw.ks.org_killed("org-a")
+
+
+async def test_sp2_unpublished_revocation_and_kill_switch_fail_closed_after_fresh_ms_without_rehydrator() -> None:
+    """repro_publish_pending_no_rehydrator: committed, publish failed (ok_publish_pending), no re-hydrator.
+    rc2: served stale forever. RC3: served stale for < RV_STATE_FRESH_MS, then 503 with Retry-After."""
+    _, r, ar = _stores()
+    db = MemDB()
+    w = StateWriter(db, r, K)
+    _seed(w)
+    clock = [time.time()]
+    gw, rc2 = _Gateway(ar, clock=lambda: clock[0]), _Gateway(ar, fresh_ms=None)
+    Rehydrator(db, r, w, period_ms=100, checkpoint_s=5).check_once()  # the last round before it stops
+    stamped = verify_stamp(K, r.get(K2_STAMP)).verified_at
+    down = fakeredis.FakeServer()
+    down.connected = False  # the store is unreachable FOR THE WRITER
+    dead = StateWriter(db, fakeredis.FakeRedis(server=down), K)
+    dead.key_revoke(KEY_R)
+    assert dead.last["status"] == "ok_publish_pending"
+    dead.killswitch("org", "org-a", True)
+    assert dead.last["status"] == "ok_publish_pending"
+    clock[0] = stamped + 2.9
+    for g in (gw, rc2):
+        await g.refresh()
+    assert await gw.outcome(KEY_R) == "200" and not gw.ks.org_killed("org-a")  # the bounded exposure
+    await gw.ident.fetch(key_hash(KEY_G))
+    assert gw.ident.cached(KEY_G)[1] is not None
+    clock[0] = stamped + 3.01
+    await gw.refresh()
+    for key in (KEY_R, KEY_G):
+        got = await gw.adm.admit(key, 10, MODEL)
+        assert isinstance(got, ErrorSpec) and (got.status, got.code, got.retry_after_s) == (
+            503, "kill_switch_unavailable", 2.0)
+    with pytest.raises(StoreDataUnavailable, match="last verified"):
+        await gw.ident.fetch(key_hash(KEY_R))  # /v1/models: 503 shared_state_unavailable
+    assert gw.ident.cached(KEY_G)[1] is None  # nor is a principal cached before the lapse trusted
+    assert not gw.ready() and isinstance(gw.plans.get("org-b"), PlanUnavailable)
+    assert await rc2.outcome(KEY_R) == "200" and not rc2.ks.org_killed("org-a")  # rc2: forever
+    Rehydrator(db, r, w, period_ms=100, checkpoint_s=5, stale_grace_ms=0).check_once()  # a re-hydrator is back
+    clock[0] = time.time()
+    await gw.refresh()
+    assert gw.ready() and await gw.outcome(KEY_R) == "401" and gw.ks.org_killed("org-a")
+
+
+async def test_a_manifest_below_the_stamp_is_refused_even_by_a_new_process() -> None:
+    """A store whose stamp is newer than one kind's manifest (a partial restore of old keys): refused, never applied."""
+    _, r, ar = _stores()
+    db = MemDB()
+    w = StateWriter(db, r, K)
+    _seed(w)
+    old_ks = r.get(K2_META + "ks"), r.hgetall("{rv2}:ks")
+    w.killswitch("org", "org-a", True)
+    gw = _Gateway(ar)
+    Rehydrator(db, r, w, period_ms=100, checkpoint_s=5).check_once()
+    r.set(K2_META + "ks", old_ks[0])
+    r.delete("{rv2}:ks")
+    r.hset("{rv2}:ks", mapping=old_ks[1])
+    with pytest.raises(StoreDataUnavailable, match="older than"):
+        await gw.ks.refresh_once()
+    assert gw.ks.state() == "stale"  # never refreshed: nothing was applied from the partial restore
+
+
+async def test_sp6_concurrent_reconciles_never_roll_the_plan_back() -> None:
+    """A push-triggered reconcile that read plan v2 finishes AFTER one that applied v3. rc2 (both ran at once)
+    swapped v2 back in and moved the version backwards; single-flight never does."""
+    _, r, ar = _stores()
+    db = MemDB()
+    w = StateWriter(db, r, K)
+    _seed(w)
+    plans = VersionedPlanSnapshot(ar, Registry(0), K, reconcile_ms=100, stale_ms=5000)  # type: ignore[arg-type]
+    await plans.load_all()
+    doc = tenants()["org-a"]
+    real_get, first = ar.get, [True]
+
+    async def slow_after_read(key: str) -> Any:
+        raw = await real_get(key)
+        if key == K2_PLAN + "org-a" and first[0]:
+            first[0] = False
+            await asyncio.sleep(0.1)  # this reconcile read v2 and stalls before swapping
+        return raw
+
+    ar.get = slow_after_read  # type: ignore[method-assign]
+    w.plan_set(dict(doc, version="a-2"))
+    a = asyncio.create_task(plans._pushed())
+    await asyncio.sleep(0.02)
+    w.plan_set(dict(doc, version="a-3"))
+    v3 = db.version("plan")
+    b = asyncio.create_task(plans._pushed())
+    await asyncio.gather(a, b)
+    assert plans.version == v3 and plans.get("org-a").version == "a-3"  # type: ignore[union-attr]
+
