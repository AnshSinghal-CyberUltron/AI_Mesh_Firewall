+class _Recorder:
+    """A psycopg connection that records its settings and statements."""
+
+    def __init__(self, log: list[Any]) -> None:
+        self.log, self.closed = log, False
+        self.isolation_level: Any = None
+        self.read_only: Any = None
+
+    def cursor(self) -> _Recorder:
+        return self
+
+    def __enter__(self) -> _Recorder:
+        return self
+
+    def __exit__(self, *a: object) -> bool:
+        return False
+
+    def execute(self, sql: str, *a: object) -> None:
+        self.log.append((sql, self.isolation_level, self.read_only))
+
+    def fetchone(self) -> tuple[int, int]:
+        return (3, 7)
+
+    def fetchall(self) -> list[Any]:
+        return []
+
+    def commit(self) -> None: ...
+
+    def rollback(self) -> None: ...
+
+    def close(self) -> None:
+        self.closed = True
+
+
+def test_postgres_sessions_are_bounded_and_publish_snapshots_take_no_locks(monkeypatch: pytest.MonkeyPatch) -> None:
+    db = PgDB("postgresql://u@h/db?options=-c%20search_path%3Drv", lock_timeout_ms=1500, statement_timeout_ms=4000,
+              idle_tx_timeout_ms=3000, tcp_user_timeout_ms=2500)
+    seen: dict[str, Any] = {}
+    log: list[Any] = []
+
+    def connect(dsn: str, **kw: Any) -> _Recorder:
+        seen.update(kw, dsn=dsn)
+        return _Recorder(log)
+
+    monkeypatch.setattr(db.psycopg, "connect", connect)
+    assert db.snapshot("ks") == (Version(3, 7), [])
+    assert seen["options"].split(" -c ") == ["-c search_path=rv", "lock_timeout=1500", "statement_timeout=4000",
+                                             "idle_in_transaction_session_timeout=3000", "tcp_user_timeout=2500"]
+    assert seen["tcp_user_timeout"] == 2500 and seen["keepalives"] == 1 and seen["connect_timeout"] == 5
+    assert all(iso == db.psycopg.IsolationLevel.REPEATABLE_READ and ro is True for _, iso, ro in log)
+    assert not any("FOR SHARE" in sql or "INSERT" in sql for sql, _, _ in log)  # waits for no writer (H7)
+    with pytest.raises(ValueError, match="idle_in_transaction_session_timeout"):
+        PgDB("", idle_tx_timeout_ms=-1)
+
