+async def test_single_flight_coalesces_triggers_that_a_later_reconcile_covers() -> None:
+    _, r, ar = _stores()
+    w = StateWriter(MemDB(), r, K)
+    _seed(w)
+    metrics = Registry(0)
+    plans = VersionedPlanSnapshot(ar, metrics, K, reconcile_ms=100, stale_ms=5000)  # type: ignore[arg-type]
+    reads = [0]
+    real = plans.reconcile_once
+
+    async def counted() -> None:
+        reads[0] += 1
+        await asyncio.sleep(0.02)
+        await real()
+
+    plans.reconcile_once = counted  # type: ignore[method-assign]
+    await asyncio.gather(*(plans.reconcile() for _ in range(6)))
+    assert reads[0] == 2 and metrics.count["plan_reconcile_coalesced"] == 4
+
