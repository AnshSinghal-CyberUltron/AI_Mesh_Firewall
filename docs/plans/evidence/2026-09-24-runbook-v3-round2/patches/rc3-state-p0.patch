+def test_fresh_ms_must_cover_a_rehydrator_period(monkeypatch: pytest.MonkeyPatch) -> None:
+    from rvproto.runtime.config import load_settings
+
+    monkeypatch.setenv("RV_STATE_FRESH_MS", "1500")
+    with pytest.raises(ValueError, match="RV_STATE_FRESH_MS"):
+        load_settings()
+    for ok in ("0", "2000", "3000"):
+        monkeypatch.setenv("RV_STATE_FRESH_MS", ok)
+        assert load_settings().v2.c36.fresh_ms == float(ok)
+    monkeypatch.delenv("RV_STATE_FRESH_MS")
+    assert load_settings().v2.c36.fresh_ms == 3000.0
