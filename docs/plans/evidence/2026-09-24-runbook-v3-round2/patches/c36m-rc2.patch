--- rvproto2-c36m-rc2-base/tests/functional/cutproxy.py	1970-01-01 05:30:00.000000000 +0530
+++ rvproto2-c36m-rc2-work/tests/functional/cutproxy.py	2026-09-24 17:30:40.113444880 +0530
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""TCP proxy for the item-4 functional runs. SIGUSR1 = cut EVERY live connection at once, both sides, with RST:
+what a failover or a network blip does to a COMMIT in flight (the server may or may not have received it; if it
+did, the write is durable and its answer is lost). Postgres itself stays up.
+
+  cutproxy.py LISTEN_PORT UPSTREAM_PORT PIDFILE [DELAY_MS]   (one JSON line per cut on stdout)
+Used by f_c36_writer.py runs: RV_DATABASE_URL points at LISTEN_PORT, a --fault runs `kill -USR1 <pid>`.
+DELAY_MS holds every client->server chunk that long, so a cut can land while a COMMIT is still in the proxy
+(never received: rolled back) as well as after Postgres has it (durable, answer lost).
+"""
+import asyncio
+import json
+import os
+import signal
+import socket
+import struct
+import sys
+import time
+
+
+async def pump(r: asyncio.StreamReader, w: asyncio.StreamWriter, delay_s: float = 0.0) -> None:
+    try:
+        while data := await r.read(65536):
+            if delay_s:
+                await asyncio.sleep(delay_s)
+            w.write(data)
+            await w.drain()
+    except (OSError, asyncio.IncompleteReadError):
+        pass
+    finally:
+        w.close()
+
+
+class Proxy:
+    def __init__(self, up: int, delay_s: float) -> None:
+        self.up, self.delay_s, self.live, self.cuts = up, delay_s, set(), 0
+
+    async def handle(self, cr: asyncio.StreamReader, cw: asyncio.StreamWriter) -> None:
+        try:
+            ur, uw = await asyncio.open_connection("127.0.0.1", self.up)
+        except OSError:
+            cw.transport.abort()
+            return
+        pair = (cw, uw)
+        self.live.add(pair)
+        try:
+            await asyncio.gather(pump(cr, uw, self.delay_s), pump(ur, cw))
+        finally:
+            self.live.discard(pair)
+
+    def cut(self) -> None:
+        self.cuts += 1
+        n = len(self.live)
+        for pair in list(self.live):
+            for w in pair:
+                sock = w.get_extra_info("socket")
+                try:
+                    sock.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
+                except (OSError, AttributeError):
+                    pass
+                w.transport.abort()
+        self.live.clear()
+        print(json.dumps({"cut": self.cuts, "connections": n, "t": time.time()}), flush=True)
+
+
+async def main() -> None:
+    listen, up, pidfile = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
+    p = Proxy(up, float(sys.argv[4]) / 1000.0 if len(sys.argv) > 4 else 0.0)
+    srv = await asyncio.start_server(p.handle, "127.0.0.1", listen)
+    asyncio.get_running_loop().add_signal_handler(signal.SIGUSR1, p.cut)
+    with open(pidfile, "w") as f:
+        f.write(str(os.getpid()))
+    async with srv:
+        await srv.serve_forever()
+
+
+asyncio.run(main())
