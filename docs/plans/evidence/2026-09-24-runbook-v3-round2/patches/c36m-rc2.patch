+++ rvproto2-c36m-rc2-work/tests/functional/f_c36_writer.py	2026-09-24 17:31:02.538644364 +0530
@@ -0,0 +1,238 @@
+"""F-C36-WRITER (RC2 item 4): control-plane writes across Postgres restarts and crashes, each reported outcome
+checked against Postgres itself.
+
+  python tests/functional/f_c36_writer.py --out DIR [--seconds 90] [--writers 4] [--rate 60] [--cli]
+         [--fault 'T:SHELL COMMAND' ...]            env: RV_DATABASE_URL, RV_REDIS_URL, RV_STATE_HMAC_KEY
+
+Writer i (a thread) sets the plan of its own org (org-fw<i>) to version "<nonce>.<i>.<n>", paced on a fixed grid
+(an attempt that would overlap the next slot skips it), through the library StateWriter or, with --cli, one
+`python -m rvproto.control plan-set` process per attempt. A re-hydrator runs throughout, as in production. Each
+--fault command runs at T seconds (e.g. `docker restart -t 2 PG`, `docker kill -s KILL PG && docker start PG`).
+Afterwards the re-hydrator runs until the store equals Postgres.
+PASS = every acknowledged ("ok", "ok_publish_pending") attempt is in rv2_log exactly once, at the version it
+reported; every "error" attempt is absent (false failures = 0); no plan version logged twice; (epoch, seq)
+unique in the plan log and strictly increasing with the log id; each writer's acknowledged versions strictly
+increase; the store equals Postgres after re-hydration. "unknown" attempts are listed with what Postgres holds
+(neither pass nor fail).
+Outcomes come from StateWriter.last (ok / ok_publish_pending / unknown / error; a CommitUnknown = unknown) or,
+with --cli, from the CLI's JSON line and exit code. RV_TREE (default: this checkout) selects the tree under test;
+a tree without statuses (pre-rc2) counts a return as "ok" and an exception as "error" (negative control).
+Connection cuts: tests/functional/cutproxy.py between the writers and Postgres, cut with `kill -USR1`.
+"""
+
+from __future__ import annotations
+
+import argparse
+import inspect
+import json
+import os
+import secrets
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+from collections import Counter, defaultdict
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(os.environ.get("RV_TREE") or Path(__file__).resolve().parents[2])  # RV_TREE: the tree under test
+sys.path.insert(0, str(ROOT))
+from rvproto.control.db import PgDB  # noqa: E402
+from rvproto.control.rehydrate import Rehydrator  # noqa: E402
+from rvproto.control.writer import StateWriter  # noqa: E402
+from rvproto.plan.fixtures import org_a  # noqa: E402
+from rvproto.runtime.storeconn import sync_client  # noqa: E402
+from rvproto.runtime.versioned import KINDS  # noqa: E402
+
+LOCK = threading.Lock()
+ACKED = ("ok", "publish_pending", "ok_publish_pending")  # committed: published / publish pending
+UNKNOWN_EXC = ("WriteOutcomeUnknown", "CommitUnknown")
+
+
+def _writer(actor: str) -> StateWriter:
+    kw: dict[str, Any] = {"resolve_s": 30.0} if "resolve_s" in inspect.signature(StateWriter).parameters else {}
+    return StateWriter(PgDB(os.environ["RV_DATABASE_URL"]), sync_client(os.environ["RV_REDIS_URL"], op_timeout_s=2.0),
+                       os.environ["RV_STATE_HMAC_KEY"].encode(), actor=actor, **kw)
+
+
+def _emit(f: Any, rec: dict[str, Any]) -> None:
+    with LOCK:
+        f.write(json.dumps(rec) + "\n")
+        f.flush()
+
+
+def _lib_attempt(w: StateWriter, doc: dict[str, Any]) -> dict[str, Any]:
+    try:
+        v = w.plan_set(doc)
+        status = getattr(v, "status", None) or getattr(w, "last", {}).get("status") or "ok"
+        return {"status": status, "state_version": str(v)}
+    except Exception as exc:  # noqa: BLE001 - the class and text are the evidence
+        unknown = type(exc).__name__ in UNKNOWN_EXC
+        return {"status": "unknown" if unknown else "error", "error": f"{type(exc).__name__}: {exc}"[:300]}
+
+
+def _cli_attempt(doc: dict[str, Any], docs: Path, actor: str) -> dict[str, Any]:
+    path = docs / f"{doc['version']}.json"
+    path.write_text(json.dumps(doc))
+    env = dict(os.environ, PYTHONPATH=str(ROOT), RV_ACTOR=actor)
+    p = subprocess.run([sys.executable, "-m", "rvproto.control", "plan-set", str(path)], capture_output=True, text=True,
+                       env=env, cwd=ROOT, timeout=120)
+    last = next((json.loads(x) for x in reversed(p.stdout.splitlines()) if x.startswith("{")), {})
+    status = last.get("status") or ("ok" if p.returncode == 0 else "error")  # pre-fix CLI: no status field
+    rec = {"status": status, "exit": p.returncode, "state_version": last.get("state_version")}
+    if p.returncode != 0:
+        rec["error"] = (last.get("error") or (p.stderr.strip().splitlines() or [""])[-1])[:300]
+    return rec
+
+
+def writer(i: int, a: argparse.Namespace, nonce: str, t0: float, out: Any, docs: Path) -> None:
+    actor = f"f-c36-writer-{i}"
+    w = None if a.cli else _writer(actor)
+    period = a.writers / a.rate
+    n = skipped = 0
+    while True:
+        slot = t0 + i * period / a.writers + n * period
+        if slot >= t0 + a.seconds:
+            break
+        now = time.monotonic()
+        if now < slot:
+            time.sleep(slot - now)
+        elif now - slot > period:
+            n, skipped = n + 1, skipped + 1
+            continue
+        n += 1
+        doc = org_a(version=f"{nonce}.{i}.{n}", org_id=f"org-fw{i}")
+        t_send = time.time()
+        rec = _cli_attempt(doc, docs, actor) if a.cli else _lib_attempt(w, doc)  # type: ignore[arg-type]
+        _emit(out, {"writer": i, "n": n, "version": doc["version"], "t_send": t_send, "t_ack": time.time(), **rec})
+    _emit(out, {"meta": "writer_done", "writer": i, "attempted": n - skipped, "skipped_slots": skipped})
+
+
+def faults(specs: list[str], t0: float, out: Any) -> None:
+    for spec in sorted(specs, key=lambda s: float(s.split(":", 1)[0])):
+        at, cmd = spec.split(":", 1)
+        time.sleep(max(0.0, t0 + float(at) - time.monotonic()))
+        t1 = time.time()
+        p = subprocess.run(cmd, shell=True, capture_output=True, text=True)
+        _emit(out, {"fault": cmd, "at_s": float(at), "t_start": t1, "t_end": time.time(), "rc": p.returncode,
+                    "err": p.stderr.strip()[-200:]})
+
+
+def rehydrator(stop: threading.Event, events: list[dict[str, Any]]) -> None:
+    rh: Rehydrator | None = None
+    while not stop.wait(1.0):
+        try:  # as Rehydrator.run(): a database failover or a store fault only delays the next round
+            if rh is None:
+                w = _writer("f-c36-rehydrator")
+                rh = Rehydrator(w.db, w.r, w, period_ms=1000, checkpoint_s=5)
+            events.extend(rh.check_once())
+        except Exception as exc:  # noqa: BLE001
+            events.append({"round_failed": f"{type(exc).__name__}: {exc}"[:200], "t": time.time()})
+
+
+def settle(deadline_s: float) -> tuple[dict[str, str | None], list[dict[str, Any]]]:
+    """Re-hydrate until the store equals Postgres for every kind (or the deadline)."""
+    end, last, events = time.monotonic() + deadline_s, {}, []  # type: ignore[var-annotated]
+    while time.monotonic() < end:
+        try:
+            w = _writer("f-c36-settle")
+            rh = Rehydrator(w.db, w.r, w, period_ms=1000, checkpoint_s=5, stale_grace_ms=0)
+            events.extend(rh.check_once())
+            last = {k: rh.diagnose(k) for k in KINDS}
+            if not any(last.values()):
+                return last, events
+        except Exception as exc:  # noqa: BLE001 - Postgres may still be recovering from the last fault
+            last = {"error": f"{type(exc).__name__}: {exc}"[:200]}
+        time.sleep(1.0)
+    return last, events
+
+
+def plan_log() -> list[tuple[int, str, int, int, str | None]]:
+    import psycopg
+
+    with psycopg.connect(os.environ["RV_DATABASE_URL"], connect_timeout=10) as c, c.cursor() as cur:
+        cur.execute("SELECT id, key, epoch, seq, body->>'version' FROM rv2_log WHERE kind = 'plan' ORDER BY id")
+        return [(int(r[0]), str(r[1]), int(r[2]), int(r[3]), r[4]) for r in cur.fetchall()]
+
+
+def check(attempts: list[dict[str, Any]], nonce: str, verify: dict[str, str | None]) -> dict[str, Any]:
+    log = plan_log()
+    mine: dict[str, list[tuple[int, int, int]]] = defaultdict(list)
+    for lid, _, e, s, ver in log:
+        if ver and ver.startswith(nonce + "."):
+            mine[ver].append((e, s, lid))
+    by = Counter(a["status"] for a in attempts)
+
+    def logged_as_acked(a: dict[str, Any]) -> bool:
+        rows = mine.get(a["version"], [])
+        return len(rows) == 1 and f"{rows[0][0]}.{rows[0][1]}" == a["state_version"]
+
+    lost = [a for a in attempts if a["status"] in ACKED and not logged_as_acked(a)]
+    false_failures = [a for a in attempts if a["status"] == "error" and a["version"] in mine]
+    unknown = [dict(a, in_postgres=a["version"] in mine) for a in attempts if a["status"] == "unknown"]
+    dup_versions = {v: len(x) for v, x in mine.items() if len(x) > 1}
+    dup_es = {f"{e}.{s}": n for (e, s), n in Counter((e, s) for _, _, e, s, _ in log).items() if n > 1}
+    ooo_log = sum(1 for p, q in zip(log, log[1:], strict=False) if (q[2], q[3]) <= (p[2], p[3]))
+    ooo_ack = 0
+    for i in {a["writer"] for a in attempts}:
+        acked = sorted((a for a in attempts if a["writer"] == i and a["status"] in ACKED), key=lambda a: a["t_ack"])
+        vs = [tuple(int(x) for x in a["state_version"].split(".")) for a in acked]
+        ooo_ack += sum(1 for p, q in zip(vs, vs[1:], strict=False) if q <= p)
+    fail_ms = sorted((a["t_ack"] - a["t_send"]) * 1000 for a in attempts if a["status"] in ("error", "unknown"))
+    res = {
+        "attempts": len(attempts), "by_status": dict(by), "in_postgres": len(mine),
+        "acknowledged_not_in_postgres": len(lost), "lost_examples": lost[:5],
+        "false_failures": len(false_failures), "false_failure_examples": false_failures[:5],
+        "unknown": unknown, "duplicate_versions": dup_versions, "duplicate_epoch_seq": dup_es,
+        "out_of_order_log": ooo_log, "out_of_order_acks": ooo_ack, "store_vs_postgres_after_rehydration": verify,
+        "error_classes": dict(Counter(a.get("error", "").split(":")[0] for a in attempts if a["status"] == "error")),
+        "failed_latency_ms_max": round(fail_ms[-1], 1) if fail_ms else None,
+    }
+    res["verdict"] = "PASS" if (not lost and not false_failures and not dup_versions and not dup_es and not ooo_log
+                                and not ooo_ack and not any(verify.values())) else "FAIL"
+    return res
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--seconds", type=float, default=90)
+    ap.add_argument("--writers", type=int, default=4)
+    ap.add_argument("--rate", type=float, default=60, help="attempts/s, all writers together")
+    ap.add_argument("--cli", action="store_true")
+    ap.add_argument("--fault", action="append", default=[])
+    a = ap.parse_args()
+    out_dir = Path(a.out)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    nonce = secrets.token_hex(3)
+    PgDB(os.environ["RV_DATABASE_URL"]).init_schema()
+    events: list[dict[str, Any]] = []
+    stop = threading.Event()
+    with open(out_dir / "attempts.jsonl", "w") as out, open(out_dir / "faults.jsonl", "w") as fo, \
+            tempfile.TemporaryDirectory() as docs:
+        _emit(out, {"meta": "start", "nonce": nonce, "tree": str(ROOT), "cli": a.cli, "writers": a.writers,
+                    "rate": a.rate, "seconds": a.seconds, "faults": a.fault, "t": time.time()})
+        t0 = time.monotonic() + 1.0
+        threads = [threading.Thread(target=writer, args=(i, a, nonce, t0, out, Path(docs))) for i in range(a.writers)]
+        threads += [threading.Thread(target=faults, args=(a.fault, t0, fo), daemon=True),
+                    threading.Thread(target=rehydrator, args=(stop, events), daemon=True)]
+        for t in threads:
+            t.start()
+        for t in threads[: a.writers]:
+            t.join()
+        stop.set()
+    verify, settle_events = settle(90)
+    attempts = [json.loads(x) for x in (out_dir / "attempts.jsonl").read_text().splitlines()]
+    attempts = [x for x in attempts if "meta" not in x]
+    res = check(attempts, nonce, verify)
+    res.update(nonce=nonce, tree=str(ROOT), cli=a.cli, rehydrated_during=sum(1 for e in events if "kind" in e),
+               rehydrate_rounds_failed=sum(1 for e in events if "round_failed" in e),
+               rehydrated_at_settle=[e for e in settle_events if "kind" in e])
+    (out_dir / "verdict.json").write_text(json.dumps(res, indent=1, default=str))
+    print(json.dumps({k: v for k, v in res.items() if not k.endswith("examples")}, default=str))
+    return 0 if res["verdict"] == "PASS" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
