+++ rvproto2-c36m-rc2-work/tests/unit/test_prometheus_exposition.py	2026-09-24 17:27:01.435060569 +0530
@@ -0,0 +1,149 @@
+"""Every /metrics is valid Prometheus text exposition, whatever operators name their orgs, plans and models.
+
+The gateway, guard and unit node exporters (over their HTTP surface) and the worker's own /metrics route are
+parsed IN FULL by prometheus_client, and every parsed metric and label name is checked against the exposition
+grammar: prometheus_client 0.21.1 accepts rc1's `rv_gc_pause_ns{gen="0"}{stat="n"}` as a label named `}{stat`,
+so a parse alone proves nothing. Metrics come from the production producers (install_gc_probe, TokenLease, the
+owner counters, ops._gauges). Label values carry operator data -- an org id, a plan version, a model name -- so a
+double quote, a backslash or a newline must round-trip; and a series that cannot be rendered validly (a raw,
+unescaped name) is left out with a `#` comment instead of invalidating the whole scrape.
+"""
+
+from __future__ import annotations
+
+import gc
+import os
+import re
+import threading
+import time
+import urllib.request
+from collections.abc import Iterator
+from http.server import ThreadingHTTPServer
+from types import SimpleNamespace
+
+import fakeredis
+import pytest
+from prometheus_client.parser import text_string_to_metric_families
+
+from rvproto.admit.quota import TokenLease
+from rvproto.edge import ops
+from rvproto.edge.exporter_http import handler
+from rvproto.runtime.exporter import NodeExporter
+from rvproto.runtime.loopguard import install_gc_probe
+from rvproto.runtime.metrics import Registry, prometheus
+from rvproto.runtime.shm_metrics import ShmRegistry
+
+TAG = f"pe{os.getpid()}"
+ORG = 'org "q"\\x\nz'  # operator data in a label value: double quote, backslash, newline
+RAW = 'owner_shed_reason{reason="a"b"}'  # a series some future call site builds without escaping
+METRIC, LABEL = re.compile(r"[a-zA-Z_:][a-zA-Z0-9_:]*"), re.compile(r"[a-zA-Z_][a-zA-Z0-9_]*")
+Series = dict[tuple[str, tuple[tuple[str, str], ...]], float]
+
+
+def parse(text: str) -> Series:
+    """The whole exposition: one sample per non-comment line, every name valid, every series exactly once."""
+    out: Series = {}
+    for fam in text_string_to_metric_families(text):
+        for s in fam.samples:
+            assert METRIC.fullmatch(s.name) and all(LABEL.fullmatch(k) for k in s.labels), f"not exposition: {s}"
+            key = (s.name, tuple(sorted(s.labels.items())))
+            assert key not in out, f"duplicate series {key}"
+            out[key] = s.value
+    assert len(out) == sum(1 for x in text.splitlines() if x.strip() and not x.startswith("#"))
+    return out
+
+
+@pytest.fixture(autouse=True)
+def gc_probes() -> Iterator[None]:
+    n = len(gc.callbacks)
+    yield
+    del gc.callbacks[n:]  # install_gc_probe registers a process-wide callback
+
+
+def _worker(tag: str, i: int) -> ShmRegistry:
+    reg = ShmRegistry(i, tag=tag, role="w", slots=(96, 512, 512))
+    install_gc_probe(reg)  # gc_pause_ns{gen="0|1|2"}: rc1's two-label-set lines
+    gc.collect()
+    reg.observe("loop_lag_ns", 180_000 + i)
+    reg.inc("admitted", 5 + i)
+    lease = TokenLease(fakeredis.aioredis.FakeRedis(), reg, chunk_tokens=100)
+    lease._local[ORG] = 100
+    assert lease.try_local(ORG, 7)  # quota_admitted_tokens{org=<operator data>}
+    reg.set("worker_ready", 1.0)
+    return reg
+
+
+def _owner(tag: str, i: int) -> ShmRegistry:
+    reg = ShmRegistry(i, tag=tag, role="o", slots=(96, 512, 512))
+    install_gc_probe(reg)
+    gc.collect()
+    reg.inc("owner_requests", 40)
+    reg.inc('owner_shed_reason{reason="queue_bound"}')
+    reg.inc(RAW)
+    reg.set("owner_backlog_ns", 250_000.0)
+    return reg
+
+
+def _scrape(exp: NodeExporter) -> str:
+    srv = ThreadingHTTPServer(("127.0.0.1", 0), handler(exp))
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    try:
+        with urllib.request.urlopen(f"http://127.0.0.1:{srv.server_address[1]}/metrics", timeout=10) as r:
+            assert r.headers["content-type"].startswith("text/plain; version=0.0.4")
+            return r.read().decode()
+    finally:
+        srv.shutdown()
+        srv.server_close()
+
+
+@pytest.mark.parametrize("kind", ["gateway", "guard", "unit"])
+def test_node_exporter_metrics_are_valid_exposition_with_operator_data(kind: str) -> None:
+    tag = f"{TAG}{kind[0]}"
+    workers = [] if kind == "guard" else [_worker(tag, 0), _worker(tag, 1)]
+    owners = [] if kind == "gateway" else [_owner(tag, 0), _owner(tag, 1)]
+    exp = NodeExporter(tag=tag, kind=kind, metrics_dir="", dump_s=0, host="127.0.0.1", port=0, export_s=60,
+                       draining=lambda: False, push=None)
+    try:
+        state: dict[str, object] = {"t": time.monotonic(), "ticks": {}, "merged": None, "owner": {}}
+        exp._signal_tick(state)
+        text = _scrape(exp)
+        s = parse(text)
+        assert {dict(k[1])["kind"] for k in s if k[0] == "rv2_signal"} == {kind}
+        if workers:
+            assert s[("rv_gc_pause_ns", (("gen", "2"), ("stat", "n")))] >= 2
+            assert s[("rv_quota_admitted_tokens_total", (("org", ORG),))] == 14  # the value round-trips
+            assert s[("rv_worker_ready", (("worker", "1"),))] == 1
+        if owners:
+            assert s[("rv_owner_requests_total", (("role", "owner"),))] == 80
+            assert s[("rv_owner_shed_reason_total", (("reason", "queue_bound"), ("role", "owner")))] == 2
+            assert "# rvproto: 1 series left out" in text  # the raw series: left out, the scrape stays valid
+    finally:
+        for reg in (*workers, *owners):
+            reg.close()
+        exp.cleanup()
+
+
+@pytest.mark.parametrize("shm", [False, True], ids=["c38-off", "c38-on"])
+def test_worker_metrics_route_is_valid_exposition_with_operator_data(shm: bool) -> None:
+    reg: Registry = ShmRegistry(3, tag=f"{TAG}r", role="w", slots=(96, 512, 512)) if shm else Registry(3)
+    try:
+        install_gc_probe(reg)
+        gc.collect()
+        ops._gauges(SimpleNamespace(  # type: ignore[arg-type]
+            metrics=reg, active_streams=1,
+            audit=SimpleNamespace(completeness=lambda: 1.0, produced=3, dropped=0, queue_stats=lambda: (0, 0.0)),
+            plans=SimpleNamespace(age_s=lambda: 0.2, versions=lambda: {ORG: 'v"2\\', "org-a": "a-1"}),
+            ks=SimpleNamespace(age_s=lambda: 0.1, orgs=frozenset({ORG}), models=frozenset({"m\nx"})),
+            gate=SimpleNamespace(gauges=lambda: {"inflight_requests": 1.0}), guard=SimpleNamespace(),
+            admission=SimpleNamespace(lease=SimpleNamespace(held=lambda: {ORG: 93}))))
+        reg.set("x_inf", float("inf"))
+        s = parse(prometheus(reg.export()))  # exactly what GET /metrics on the serving port returns
+        assert s[("rv_plan_version_info", (("org", ORG), ("version", 'v"2\\')))] == 1
+        assert s[("rv_plan_version_info", (("org", "org-a"), ("version", "a-1")))] == 1
+        assert s[("rv_killswitch_engaged", (("key", ORG), ("scope", "org")))] == 1
+        assert s[("rv_killswitch_engaged", (("key", "m\nx"), ("scope", "model")))] == 1
+        assert s[("rv_lease_held_tokens", (("org", ORG),))] == 93 and s[("rv_x_inf", ())] == float("inf")
+        assert s[("rv_gc_pause_ns", (("gen", "2"), ("stat", "n")))] >= 1
+    finally:
+        if isinstance(reg, ShmRegistry):
+            reg.close()
