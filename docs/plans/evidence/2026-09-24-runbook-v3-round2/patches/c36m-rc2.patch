@@ -0,0 +1,178 @@
+"""C36 writer honesty beyond rc2: never "ok" when something is still pending, never "unknown" when Postgres can
+answer.
+
+  budget-set whose live-counter write fails   ok_publish_pending (the new budget is not live until the
+                                              re-hydrator resets the counter), never "ok"
+  COMMIT answer lost, write durable           read back from rv2_log: ok (then published as usual)
+  COMMIT answer lost, write not durable       read back: error (NotCommitted), nothing written
+  COMMIT answer lost, Postgres unreadable     unknown (exit 3) after RV_WRITE_RESOLVE_S -- the only "unknown"
+  a READ whose COMMIT answer is lost          complete: its rows are read and it wrote nothing
+The in-memory Postgres twin + fakeredis; the real-Postgres runs (restarts, RST cuts, CLI) are
+tests/functional/f_c36_writer.py.
+"""
+
+from __future__ import annotations
+
+import io
+import json
+from contextlib import redirect_stdout
+from typing import Any
+
+import fakeredis
+import psycopg
+import pytest
+import redis
+
+from rvproto.control import __main__ as cli
+from rvproto.control.db import CommitUnknown, MemDB, PgDB
+from rvproto.control.rehydrate import Rehydrator
+from rvproto.control.writer import StateWriter
+from rvproto.runtime.store import K2_BUDGET, K2_BUDGET_GEN, K2_META
+from rvproto.runtime.versioned import Version, make_record, verify_meta
+
+K = b"test-hmac-key-not-a-secret"
+
+
+class NoMset:
+    """The store takes the publish (MULTI/EXEC), but the live budget-counter MSET fails."""
+
+    def __init__(self, r: Any) -> None:
+        self.r = r
+
+    def mset(self, *a: Any, **kw: Any) -> Any:
+        raise redis.ConnectionError("injected: the live-counter write is lost")
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self.r, name)
+
+
+def _stack() -> tuple[fakeredis.FakeServer, fakeredis.FakeRedis, MemDB]:
+    server = fakeredis.FakeServer()
+    return server, fakeredis.FakeRedis(server=server), MemDB()
+
+
+def _store_version(r: Any, kind: str) -> Version:
+    m = verify_meta(K, kind, r.get(K2_META + kind), not_before=Version(0, 0))
+    return Version(m["epoch"], m["seq"])
+
+
+def _cli(monkeypatch: pytest.MonkeyPatch, w: StateWriter, *argv: str) -> tuple[int, dict[str, Any]]:
+    monkeypatch.setattr(cli, "_writer", lambda: w)
+    out = io.StringIO()
+    with redirect_stdout(out):
+        code = cli.main(list(argv))
+    return code, json.loads(out.getvalue().splitlines()[-1])
+
+
+def test_budget_set_whose_counter_write_fails_is_ok_publish_pending_never_ok(monkeypatch: pytest.MonkeyPatch) -> None:
+    _, r, db = _stack()
+    w = StateWriter(db, NoMset(r), K)
+    v = w.budget_set("org-a", 5000)
+    assert w.last["status"] == "ok_publish_pending" and _store_version(r, "budget") == v  # record published ...
+    assert r.get(K2_BUDGET + "org-a") is None  # ... the live counter not: the new budget is not in effect yet
+    code, out = _cli(monkeypatch, w, "budget-set", "org-b", "7")
+    assert (code, out["status"]) == (0, "ok_publish_pending"), out
+    Rehydrator(db, r, w, period_ms=100, checkpoint_s=5, stale_grace_ms=0).check_once()
+    assert int(r.get(K2_BUDGET + "org-a")) == 5000 and r.get(K2_BUDGET_GEN + "org-a").decode() == str(v)
+
+
+def test_a_lost_commit_answer_of_a_durable_write_is_read_back_as_ok_and_published() -> None:
+    _, r, db = _stack()
+    w = StateWriter(db, r, K)
+    w.killswitch("global", None, False)
+    db.commit_unknown_next = True  # the COMMIT is durable, its answer lost
+    v = w.killswitch("org", "org-a", True)  # rc2: CommitUnknown, "unknown"
+    assert w.last["status"] == "ok" and v == Version(1, 2) and _store_version(r, "ks") == v
+
+
+def test_a_lost_commit_answer_of_a_write_that_never_landed_is_read_back_as_error() -> None:
+    from rvproto.control.writer import NotCommitted
+
+    _, r, db = _stack()
+    w = StateWriter(db, r, K)
+    w.killswitch("global", None, False)
+    db.commit_lost_next = True  # the COMMIT never reached the server, its answer lost too
+    with pytest.raises(NotCommitted):
+        w.killswitch("org", "org-a", True)
+    assert w.last["status"] == "error" and db.version("ks") == Version(1, 1) and _store_version(r, "ks") == Version(1, 1)
+
+
+def test_unknown_only_while_postgres_cannot_be_read_back() -> None:
+    _, r, db = _stack()
+    w = StateWriter(db, r, K)
+    w.killswitch("global", None, False)
+    w.resolve_s = 0.2
+    db.commit_unknown_next, db.down = True, 10**6
+    with pytest.raises(CommitUnknown):
+        w.killswitch("org", "org-a", True)
+    assert w.last["status"] == "unknown" and w.last["version"] == "1.2"  # never "ok"
+    db.down = 3  # Postgres answers again after 3 failed reads: resolved, not unknown
+    w.resolve_s = 5.0
+    db.commit_unknown_next = True
+    w.killswitch("org", "org-b", True)
+    assert w.last["status"] == "ok" and db.down == 0
+
+
+def test_cli_exit_codes_after_read_back(monkeypatch: pytest.MonkeyPatch) -> None:
+    _, r, db = _stack()
+    w = StateWriter(db, r, K)
+    assert _cli(monkeypatch, w, "killswitch", "global", "off")[0] == 0
+    db.commit_unknown_next = True
+    assert _cli(monkeypatch, w, "killswitch", "org", "org-a", "on")[1]["status"] == "ok"
+    db.commit_lost_next = True
+    code, out = _cli(monkeypatch, w, "killswitch", "org", "org-b", "on")
+    assert (code, out["status"]) == (1, "error") and db.version("ks") == Version(1, 2), out
+    w.resolve_s, db.commit_unknown_next, db.down = 0.2, True, 10**6
+    code, out = _cli(monkeypatch, w, "killswitch", "org", "org-c", "on")
+    assert (code, out["status"]) == (3, "unknown"), out
+
+
+class _Cursor:
+    def __init__(self, rows: list[tuple[Any, ...]]) -> None:
+        self.rows = rows
+
+    def __enter__(self) -> _Cursor:
+        return self
+
+    def __exit__(self, *a: object) -> bool:
+        return False
+
+    def execute(self, *a: object) -> None:
+        return None
+
+    def fetchall(self) -> list[tuple[Any, ...]]:
+        return self.rows
+
+    def fetchone(self) -> tuple[Any, ...] | None:
+        return self.rows[0] if self.rows else None
+
+
+class _AnswerLost:
+    """A psycopg connection whose statements answer, but whose COMMIT answer is lost (the failover lands there)."""
+
+    closed = False
+
+    def __init__(self, rows: list[tuple[Any, ...]]) -> None:
+        self.rows = rows
+
+    def cursor(self) -> _Cursor:
+        return _Cursor(self.rows)
+
+    def commit(self) -> None:
+        raise psycopg.OperationalError("consuming input failed: server closed the connection unexpectedly")
+
+    def rollback(self) -> None:
+        raise psycopg.OperationalError("the connection is lost")
+
+    def close(self) -> None:
+        self.closed = True
+
+
+def test_a_read_whose_commit_answer_is_lost_is_complete_but_a_write_is_not() -> None:
+    rec = make_record(K, "key", "h1", {"key_id": "k", "org_id": "org-a", "rate_per_s": 1, "burst": 1}, Version(1, 1))
+    row = tuple(rec[c] for c in ("kind", "key", "epoch", "seq", "hash", "deleted", "op", "sig", "body"))
+    db = PgDB("postgresql://unused")
+    db._conn = lambda: _AnswerLost([row])  # type: ignore[method-assign]
+    assert [x["key"] for x in db.records("key")] == ["h1"]  # rc2: CommitUnknown -> key-revoke reported unknown
+    with pytest.raises(CommitUnknown), db.tx() as t:  # a WRITE whose COMMIT answer is lost stays undecided here
+        t.set_version("key", Version(1, 2))
