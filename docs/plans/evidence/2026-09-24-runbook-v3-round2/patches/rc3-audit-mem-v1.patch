+"""Store memory safety (H1/SP7): the startup self-check, the store memory gauges and the audit memory budget.
+
+Audit streams never expire, and the guard-owner registrations (SET PX, discovery) are the ONLY keys with a TTL.
+Under an evicting maxmemory-policy (volatile-*: Memorystore's default is volatile-lru; allkeys-*: evicts durable
+state too) a store that audit fills evicts exactly those registrations -- discovery 0/N, new gateways never ready
+-- and then refuses every write: audit, new lease counters, and the control plane's publishes, so a kill switch
+or a key revocation never reaches the gateways, which keep serving the old, still-valid snapshot.
+Defences: audit/sink.py keeps every audit stream inside a memory budget (this module derives it); every worker
+checks the policy at startup (ERROR log + store_policy_unsafe=1 for any evicting policy: run noeviction plus the
+bound); worker 0 samples INFO memory/stats every RV_STORE_MEMORY_SAMPLE_S off the request path and exports
+store_used_memory_bytes, store_maxmemory_bytes, store_memory_used_ratio, store_evicted_keys, store_policy_unsafe.
+INFO works on Memorystore, where CONFIG is restricted; CONFIG GET is only a fallback for the policy.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import sys
+import time
+from collections.abc import Callable
+from dataclasses import dataclass
+from typing import Any
+
+from rvproto.runtime.config_v2 import AuditMemory
+from rvproto.runtime.metrics import Registry
+from rvproto.runtime.store import StoreError
+
+_MIB = 1 << 20
+
+
+@dataclass(frozen=True, slots=True)
+class StoreMemory:
+    used: int
+    maxmemory: int  # 0 = no limit
+    policy: str
+    evicted_keys: int
+
+
+def policy_unsafe(policy: str) -> bool:
+    """Any evicting policy can remove what the gateways need: volatile-* the registrations, allkeys-* also state."""
+    return policy.startswith(("volatile-", "allkeys-"))
+
+
+def _log(event: str, **kw: object) -> None:
+    sys.stderr.write(json.dumps({"event": event, "t": time.time(), **kw}, default=str) + "\n")
+    sys.stderr.flush()
+
+
+async def _config_policy(r: Any) -> str:
+    try:
+        got = await r.config_get("maxmemory-policy")
+    except StoreError:  # e.g. Memorystore: CONFIG is not available to clients
+        return ""
+    v = got.get("maxmemory-policy", got.get(b"maxmemory-policy", "")) if isinstance(got, dict) else ""
+    return v.decode() if isinstance(v, bytes) else str(v)
+
+
+async def read_memory(r: Any) -> StoreMemory:
+    """INFO memory + INFO stats (two small round trips). Raises StoreError."""
+    mem = await r.info("memory")
+    stats = await r.info("stats")
+    policy = str(mem.get("maxmemory_policy") or "") or await _config_policy(r)
+    return StoreMemory(used=int(mem.get("used_memory", 0)), maxmemory=int(mem.get("maxmemory", 0)),
+                       policy=policy, evicted_keys=int(stats.get("evicted_keys", 0)))
+
+
+def audit_budget(knobs: AuditMemory, mem: StoreMemory | None) -> tuple[int | None, str]:
+    """(bytes all audit streams may use, where it came from); None = unknown (RV_AUDIT_STREAM_MAXLEN only)."""
+    if knobs.budget_mb is not None:
+        return int(knobs.budget_mb * _MIB), "RV_AUDIT_STORE_BUDGET_MB"
+    if mem is not None and mem.maxmemory > 0:
+        return int(mem.maxmemory * knobs.fraction), f"RV_AUDIT_STORE_FRACTION={knobs.fraction} x maxmemory"
+    return None, "none (store maxmemory unknown or 0): audit bounded by RV_AUDIT_STREAM_MAXLEN only"
+
+
+def publish(metrics: Registry, mem: StoreMemory) -> None:
+    metrics.set("store_used_memory_bytes", mem.used)
+    metrics.set("store_maxmemory_bytes", mem.maxmemory)
+    metrics.set("store_memory_used_ratio", mem.used / mem.maxmemory if mem.maxmemory > 0 else 0.0)
+    metrics.set("store_evicted_keys", mem.evicted_keys)
+    metrics.set("store_policy_unsafe", 1.0 if policy_unsafe(mem.policy) else 0.0)
+
+
+async def startup_check(r: Any, metrics: Registry, knobs: AuditMemory, *, worker: int) -> StoreMemory | None:
+    """Every worker at startup: log the store's memory settings; ERROR for an evicting policy. Never fatal."""
+    try:
+        mem = await read_memory(r)
+    except StoreError as exc:
+        _log("store_memory_check_failed", worker=worker, error=f"{type(exc).__name__}: {exc}"[:300])
+        return None
+    publish(metrics, mem)
+    budget, source = audit_budget(knobs, mem)
+    _log("store_memory_check", worker=worker, used_memory=mem.used, maxmemory=mem.maxmemory,
+         maxmemory_policy=mem.policy, evicted_keys=mem.evicted_keys, audit_budget_bytes=budget, audit_budget=source)
+    if policy_unsafe(mem.policy):
+        _log("store_policy_unsafe", severity="ERROR", worker=worker, maxmemory_policy=mem.policy,
+             detail="an evicting maxmemory-policy removes the guard-owner registrations (the only TTL keys) first "
+                    "and, once full, refuses the control plane's publishes: set maxmemory-policy noeviction and keep "
+                    "audit inside RV_AUDIT_STORE_BUDGET_MB (store_policy_unsafe=1)")
+    if mem.maxmemory == 0:
+        _log("store_memory_unbounded", severity="WARNING", worker=worker, detail="store maxmemory is 0 (no limit): "
+             "set a limit and noeviction, or RV_AUDIT_STORE_BUDGET_MB, so audit cannot grow without bound")
+    elif budget is not None and budget > mem.maxmemory * 0.9:
+        _log("audit_budget_exceeds_store", severity="ERROR", worker=worker, audit_budget_bytes=budget,
+             maxmemory=mem.maxmemory, detail="RV_AUDIT_STORE_BUDGET_MB leaves < 10% of maxmemory for durable state "
+             "and guard registrations")
+    return mem
+
+
+class MemorySampler:
+    """INFO memory/stats every sample_s (worker 0, off the request path): gauges, and the fresh maxmemory to
+    on_memory (the audit budget follows a store resize)."""
+
+    def __init__(self, r: Any, metrics: Registry, knobs: AuditMemory,
+                 on_memory: Callable[[StoreMemory], None] | None = None) -> None:
+        self.r = r
+        self.metrics = metrics
+        self.period_s = knobs.sample_s
+        self.on_memory = on_memory
+        self._failing = False
+
+    async def sample_once(self) -> StoreMemory | None:
+        try:
+            mem = await read_memory(self.r)
+        except StoreError as exc:
+            self.metrics.inc("store_memory_sample_errors")
+            if not self._failing:  # log the first failure of a run of failures only
+                _log("store_memory_sample_failed", error=f"{type(exc).__name__}: {exc}"[:300])
+            self._failing = True
+            return None
+        self._failing = False
+        publish(self.metrics, mem)
+        if self.on_memory is not None:
+            self.on_memory(mem)
+        return mem
+
+    async def run(self) -> None:
+        while True:
+            await asyncio.sleep(self.period_s)
+            try:
+                await self.sample_once()
+            except asyncio.CancelledError:
+                raise
+            except Exception as exc:  # noqa: BLE001 - a sampler bug must never stop the audit writer beside it
+                _log("store_memory_sampler_error", error=f"{type(exc).__name__}: {exc}"[:300])
