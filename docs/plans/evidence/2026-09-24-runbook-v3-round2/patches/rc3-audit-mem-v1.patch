+"""H1/SP7: audit streams inside a store memory budget, the startup policy check, the store memory gauges.
+
+The end-to-end proof against a real Valkey 8 (maxmemory 64 MB, volatile-lru: registrations evicted and publishes
+refused on RC2; neither with the budget) is tests/functional/f_audit_mem.py.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from typing import Any
+
+import fakeredis
+import pytest
+from redis.exceptions import ConnectionError as RedisConnectionError
+
+from rvproto.audit.sink import AuditSink
+from rvproto.domain.ports import DecisionRecord
+from rvproto.runtime import storemem
+from rvproto.runtime.config import load_settings
+from rvproto.runtime.config_v2 import AuditMemory, describe_v2
+from rvproto.runtime.metrics import Registry
+from rvproto.runtime.store import K_AUDIT_PREFIX
+
+MIB = 1 << 20
+POLICIES = ("noeviction", "volatile-lru", "volatile-lfu", "volatile-random", "volatile-ttl", "allkeys-lru",
+            "allkeys-lfu", "allkeys-random")
+
+
+def _rec(org: str, i: int, pad: int = 600) -> DecisionRecord:
+    return DecisionRecord(request_id=f"rid-{i}", org_id=org, key_id="k", phase="input", plan_version="v1",
+                          disposition="ALLOW", deciding_rules=(), unavailable_detectors=(),
+                          findings=({"evidence": "e" * pad},), verification="OK", stages="canon:E", wall_ns=i)
+
+
+class _Store:
+    """INFO memory / INFO stats / CONFIG GET as a Valkey answers them (redis-py parses INFO into dicts)."""
+
+    def __init__(self, policy: str | None, used: int = 10 * MIB, maxmemory: int = 64 * MIB, evicted: int = 0,
+                 config: bool = True, down: bool = False) -> None:
+        self.policy, self.used, self.maxmemory, self.evicted = policy, used, maxmemory, evicted
+        self.config, self.down = config, down
+
+    async def info(self, section: str) -> dict[str, Any]:
+        if self.down:
+            raise RedisConnectionError("store unreachable")
+        if section == "memory":
+            d: dict[str, Any] = {"used_memory": self.used, "maxmemory": self.maxmemory}
+            if self.policy is not None:
+                d["maxmemory_policy"] = self.policy
+            return d
+        return {"evicted_keys": self.evicted}
+
+    async def config_get(self, name: str) -> dict[bytes, bytes]:
+        if not self.config:  # Memorystore: CONFIG is not available to clients
+            raise RedisConnectionError("unknown command 'CONFIG'")
+        return {b"maxmemory-policy": b"allkeys-lru"}
+
+
+def _knobs(budget_mb: float | None = None, fraction: float = 0.5, sample_s: float = 10.0) -> AuditMemory:
+    return AuditMemory(budget_mb=budget_mb, fraction=fraction, sample_s=sample_s)
+
+
+def test_every_evicting_policy_is_unsafe_and_only_noeviction_is_safe() -> None:
+    assert [p for p in POLICIES if not storemem.policy_unsafe(p)] == ["noeviction"]
+
+
+async def test_read_memory_uses_info_and_falls_back_to_config_get_for_the_policy() -> None:
+    mem = await storemem.read_memory(_Store("volatile-lru", used=5, maxmemory=9, evicted=3))
+    assert mem == storemem.StoreMemory(used=5, maxmemory=9, policy="volatile-lru", evicted_keys=3)
+    assert (await storemem.read_memory(_Store(None))).policy == "allkeys-lru"  # INFO without it: CONFIG GET
+    assert (await storemem.read_memory(_Store(None, config=False))).policy == ""  # neither: unknown, not unsafe
+
+
+def test_audit_budget_is_explicit_else_a_fraction_of_maxmemory_else_unknown() -> None:
+    mem = storemem.StoreMemory(used=0, maxmemory=100 * MIB, policy="noeviction", evicted_keys=0)
+    assert storemem.audit_budget(_knobs(budget_mb=8), mem)[0] == 8 * MIB
+    assert storemem.audit_budget(_knobs(fraction=0.25), mem)[0] == 25 * MIB
+    assert storemem.audit_budget(_knobs(), storemem.StoreMemory(0, 0, "noeviction", 0))[0] is None  # no limit
+    assert storemem.audit_budget(_knobs(), None)[0] is None  # store unreachable at startup
+
+
+@pytest.mark.parametrize("policy", POLICIES)
+async def test_startup_check_flags_an_evicting_policy_with_an_error_log_and_a_gauge(
+        policy: str, capsys: pytest.CaptureFixture[str]) -> None:
+    m = Registry(0)
+    mem = await storemem.startup_check(_Store(policy), m, _knobs(), worker=0)
+    assert mem is not None and mem.policy == policy
+    events = [json.loads(x) for x in capsys.readouterr().err.splitlines() if x.startswith("{")]
+    unsafe = [e for e in events if e["event"] == "store_policy_unsafe"]
+    assert m.gauge["store_policy_unsafe"] == (0.0 if policy == "noeviction" else 1.0)
+    assert (unsafe == []) == (policy == "noeviction")
+    assert all(e["severity"] == "ERROR" for e in unsafe)
+    assert m.gauge["store_memory_used_ratio"] == pytest.approx(10 / 64)
+
+
+async def test_startup_check_warns_about_an_unlimited_store_and_an_oversized_budget(
+        capsys: pytest.CaptureFixture[str]) -> None:
+    await storemem.startup_check(_Store("noeviction", maxmemory=0), Registry(0), _knobs(), worker=0)
+    await storemem.startup_check(_Store("noeviction", maxmemory=64 * MIB), Registry(0), _knobs(budget_mb=60), worker=0)
+    events = {e["event"]: e for e in (json.loads(x) for x in capsys.readouterr().err.splitlines() if x.startswith("{"))}
+    assert events["store_memory_unbounded"]["severity"] == "WARNING"
+    assert events["audit_budget_exceeds_store"]["severity"] == "ERROR"
+
+
+async def test_startup_check_never_fails_startup_when_the_store_is_unreachable() -> None:
+    m = Registry(0)
+    assert await storemem.startup_check(_Store("noeviction", down=True), m, _knobs(), worker=1) is None
+    assert "store_policy_unsafe" not in m.gauge
+
+
+async def test_sampler_publishes_gauges_rederives_the_budget_and_survives_errors(
+        capsys: pytest.CaptureFixture[str]) -> None:
+    m, seen = Registry(0), []
+    st = _Store("noeviction", used=32 * MIB, maxmemory=128 * MIB, evicted=7)
+    sampler = storemem.MemorySampler(st, m, _knobs(sample_s=0.01), on_memory=seen.append)
+    await sampler.sample_once()
+    assert (m.gauge["store_used_memory_bytes"], m.gauge["store_maxmemory_bytes"]) == (32 * MIB, 128 * MIB)
+    assert m.gauge["store_memory_used_ratio"] == 0.25 and m.gauge["store_evicted_keys"] == 7
+    assert seen[-1].maxmemory == 128 * MIB
+    st.down = True
+    for _ in range(3):
+        assert await sampler.sample_once() is None
+    assert m.count["store_memory_sample_errors"] == 3
+    assert capsys.readouterr().err.count("store_memory_sample_failed") == 1  # one log per run of failures
+    task = asyncio.create_task(sampler.run())
+    await asyncio.sleep(0.05)
+    assert not task.done()  # errors never end the loop
+    task.cancel()
+
+
+def test_per_org_maxlen_is_an_equal_byte_share_of_the_budget_whatever_the_record_size() -> None:
+    sink = AuditSink(fakeredis.aioredis.FakeRedis(), Registry(0), stream_maxlen=2_000_000, org_count=lambda: 4)
+    assert sink.stream_maxlen("org-a") == 2_000_000  # no budget: the frozen per-org bound
+    sink.set_budget(64 * MIB)
+    assert sink.stream_maxlen("org-a") == 2_000_000  # no record of org-a seen yet
+    sink.payload_ewma.update({"org-a": 2900.0, "org-b": 29000.0})
+    for org, size in (("org-a", 2900), ("org-b", 29000)):
+        assert sink.bytes_per_record(org) == pytest.approx(size * 1.10 + 256)
+        assert sink.stream_maxlen(org) == int(64 * MIB / (4 * (size * 1.10 + 256)))
+        share, bpr = 16 * MIB, sink.bytes_per_record(org)
+        assert share - bpr < sink.stream_maxlen(org) * bpr <= share  # an equal byte share, floored to whole records
+    sink.set_budget(1)
+    assert sink.stream_maxlen("org-a") == 100  # never below the retention floor
+    sink.set_budget(10**15)
+    assert sink.stream_maxlen("org-a") == 2_000_000  # never above RV_AUDIT_STREAM_MAXLEN
+
+
+async def test_writer_trims_every_stream_it_touches_to_its_share_and_counts_what_it_removed() -> None:
+    r, m = fakeredis.aioredis.FakeRedis(), Registry(0)
+    sink = AuditSink(r, m, stream_maxlen=2_000_000, org_count=lambda: 2)
+    budget = 2 * 1200 * (700 * 1.10 + 256)  # ~1,200 records of ~700 bytes per org
+    sink.set_budget(int(budget))
+    for n in range(60):  # 3,000 records per org; org-b's records are ~9x larger
+        await sink._write([_rec("org-a", n * 100 + i) if i % 2 else _rec("org-b", n * 100 + i, pad=6000)
+                           for i in range(100)])
+    lens = {o: await r.xlen(K_AUDIT_PREFIX + o) for o in ("org-a", "org-b")}
+    for org, n in lens.items():
+        assert n <= sink.stream_maxlen(org), (org, n)
+        bpr = sink.bytes_per_record(org)
+        assert budget / 2 - bpr < sink.stream_maxlen(org) * bpr <= budget / 2  # equal byte shares
+    assert lens["org-a"] > 5 * lens["org-b"]  # the larger records get proportionally fewer entries
+    assert sink.written == 6000 and sink.failed == 0
+    assert m.count["audit_trimmed_records"] == sink.trimmed == 6000 - sum(lens.values())  # exact, from XTRIM
+    assert m.gauge["audit_stream_maxlen"] == sink.stream_maxlen("org-b")  # the most constrained stream
+    assert m.gauge["audit_budget_bytes"] == int(budget) and m.gauge["audit_bytes_per_record"] > 6000
+
+
+async def test_the_sampler_runs_beside_the_writer_and_stops_with_it() -> None:
+    m = Registry(0)
+    sink = AuditSink(fakeredis.aioredis.FakeRedis(), m, stream_maxlen=1000)
+    sink.configure(10)
+    sink.sampler = storemem.MemorySampler(_Store("noeviction"), m, _knobs(sample_s=0.01))
+    task = asyncio.create_task(sink.run())
+    sink.emit(_rec("org-a", 1))
+    await asyncio.sleep(0.1)
+    assert sink.written == 1 and "store_used_memory_bytes" in m.gauge
+    task.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await task
+
+
+def test_audit_memory_knobs_default_parse_and_validate() -> None:
+    a = load_settings({}).v2.audit
+    assert (a.budget_mb, a.fraction, a.sample_s) == (None, 0.5, 10.0)
+    assert load_settings({"RV_AUDIT_STORE_BUDGET_MB": "512"}).v2.audit.budget_mb == 512.0
+    assert "audit" in describe_v2(load_settings({}).v2)
+    for bad in ({"RV_AUDIT_STORE_BUDGET_MB": "0"}, {"RV_AUDIT_STORE_FRACTION": "0.95"},
+                {"RV_AUDIT_STORE_FRACTION": "0"}, {"RV_STORE_MEMORY_SAMPLE_S": "0"}):
+        with pytest.raises(ValueError):
+            load_settings(bad)
