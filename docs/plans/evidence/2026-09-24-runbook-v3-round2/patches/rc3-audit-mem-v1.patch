+"""F-AUDIT-MEM (H1/SP7): audit streams must not push the store to maxmemory, where an evicting policy evicts the
+guard-owner registrations (the only TTL keys) and every write -- the control plane's publishes included -- is
+refused, so a kill switch never reaches the gateways.
+
+  python tests/functional/f_audit_mem.py REDIS_URL [DRIVE_S=20]   (a PRIVATE store: it is FLUSHALLed)
+  env: RV_TREE (tree to test, default: the one holding this file), RV_AUDIT_* knobs are passed through
+
+Against a store with a small maxmemory (64 MB) and volatile-lru (Memorystore's default policy):
+- The gateway's own audit construction is used: edge.state.audit_sink() (startup check + memory budget + sampler)
+  where it exists, else the pre-fix AuditSink(stream_maxlen=RV_AUDIT_STREAM_MAXLEN).
+- 5 guard owners heartbeat as in production (discovery.OwnerRegistration: SET PX 3000 every 1 s).
+- Realistic 2.9 KB DecisionRecords (org-a / org-b) are emitted at 4,000/s for DRIVE_S: 3-4x maxmemory of audit.
+- Every 0.5 s: live registrations, a control-plane publish (writer.publish_safe), a lease refill (LEASE_LUA_V2),
+  INFO memory/stats.
+- At the end: a kill switch for org-b through the writer, then a gateway-style refresh.
+PASS: registrations 5/5 throughout, 0 evicted keys, 0 refused publishes / lease refills / audit writes,
+used_memory < maxmemory, and the kill switch is published and seen as engaged.
+Prints one JSON result line; exit 0 = PASS, 1 = FAIL.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import sys
+import time
+import uuid
+from pathlib import Path
+from typing import Any
+
+import redis
+import redis.asyncio as aioredis
+import uvloop
+
+sys.path.insert(0, os.environ.get("RV_TREE") or str(Path(__file__).resolve().parents[2]))
+from rvproto.admit.quota import TokenLease  # noqa: E402
+from rvproto.admit.state_v2 import VersionedIdentity, VersionedKillSwitch  # noqa: E402
+from rvproto.audit.sink import AuditSink  # noqa: E402
+from rvproto.control.db import MemDB  # noqa: E402
+from rvproto.control.writer import StateWriter  # noqa: E402
+from rvproto.detect.guard.discovery import OwnerRegistration  # noqa: E402
+from rvproto.domain.ports import DecisionRecord  # noqa: E402
+from rvproto.plan.fixtures import tenants  # noqa: E402
+from rvproto.plan.snapshot_v2 import VersionedPlanSnapshot  # noqa: E402
+from rvproto.runtime import store  # noqa: E402
+from rvproto.runtime.config import load_settings  # noqa: E402
+from rvproto.runtime.metrics import Registry  # noqa: E402
+
+K = b"f-audit-mem-hmac-not-a-secret"
+OWNERS = 5
+RATE, TICK_S = 4000, 0.1
+
+
+class _Contract:
+    target_p99_ms = 20.0
+
+
+class _Bounds:
+    redis_connections = 16
+
+
+def record(org: str, i: int) -> DecisionRecord:
+    """A 2.9 KB input-phase record (the size r2 measured per audit record)."""
+    findings = tuple({"detector": f"det-{k}", "version": "2026.09", "category": "prompt_injection",
+                      "status": "executed", "confidence": 0.0123 * k, "spans": [[0, 17 * k, 17 * k + 43]],
+                      "evidence": f"{'e' * 131}{i:08d}"} for k in range(9))
+    return DecisionRecord(request_id=str(uuid.uuid4()), org_id=org, key_id=f"key-{org[-1]}-1", phase="input",
+                          plan_version=f"{org[-1]}-1", disposition="ALLOW", deciding_rules=("r-pii", "r-inj"),
+                          unavailable_detectors=(), findings=findings, verification="OK",
+                          stages="canon:E,det:E,sem:E,resolve:E,dispatch:E,out:E,audit:E", wall_ns=time.time_ns())
+
+
+def seed(url: str) -> StateWriter:
+    w = StateWriter(MemDB(), redis.Redis.from_url(url), K)
+    w.key_add("sk-rv-org-a-0001", "org-a", key_id="key-a-1", rate=1e6, burst=1e6)
+    for org, doc in tenants().items():
+        w.plan_set(doc)
+        w.budget_set(org, 10**12)
+        w.killswitch("org", org, False)
+    w.killswitch("global", None, False)
+    return w
+
+
+async def build_sink(url: str, m: Registry, plans: VersionedPlanSnapshot, r_bg: aioredis.Redis) -> AuditSink:
+    s = load_settings({**{k: v for k, v in os.environ.items() if k.startswith("RV_AUDIT_")},
+                       "RV_REDIS_URL": url, "RV_WORKER_INDEX": "0"})
+    try:
+        from rvproto.edge.state import audit_sink  # the gateway's own construction (with the fix)
+    except ImportError:
+        return AuditSink(r_bg, m, stream_maxlen=s.audit_stream_maxlen)  # pre-fix construction
+    return await audit_sink(s, m, r_bg, plans)
+
+
+async def probe(probe_r: aioredis.Redis, w: StateWriter, lease: TokenLease, ids: list[str]) -> dict[str, Any]:
+    alive = sum([bool(await probe_r.exists(store.K2_GUARD_OWNER + i)) for i in ids])
+    published = await asyncio.to_thread(w.publish_safe, "ks")
+    try:
+        await lease.refill("org-a", 1000)  # a counter DECRBY through LEASE_LUA_V2 (answered, not refused)
+        leased: bool | str = True
+    except store.StoreError as exc:
+        leased = f"{type(exc).__name__}: {exc}"[:80]
+    mem, stats = await probe_r.info("memory"), await probe_r.info("stats")
+    return {"t": round(time.monotonic(), 2), "regs_alive": alive, "publish_ok": published, "lease": leased,
+            "used_memory": int(mem["used_memory"]), "maxmemory": int(mem["maxmemory"]),
+            "policy": mem["maxmemory_policy"], "evicted_keys": int(stats["evicted_keys"])}
+
+
+async def main(url: str, drive_s: float) -> dict[str, Any]:
+    redis.Redis.from_url(url).flushall()
+    w = await asyncio.to_thread(seed, url)
+    m = Registry(0)
+    r_bg = store.connect_background(url, _Contract(), _Bounds())  # type: ignore[arg-type]
+    r_req = store.connect(url, _Contract(), _Bounds(), timeout_s=0.5)  # type: ignore[arg-type]
+    probe_r = aioredis.Redis.from_url(url)
+    plans = VersionedPlanSnapshot(r_bg, m, K, reconcile_ms=1000, stale_ms=5000)
+    await plans.load_all()
+    regs = [OwnerRegistration(url, advertise=(f"10.9.0.{i}", 7070), hello={"index": i, "pid": 1, "tokens_per_s": 1.0,
+                                                                           "model_hash": "m"}, ttl_ms=3000)
+            for i in range(OWNERS)]
+    tasks = [asyncio.create_task(g.run()) for g in regs]
+    sink = await build_sink(url, m, plans, r_bg)
+    sink.configure(20000)
+    tasks.append(asyncio.create_task(sink.run()))
+    lease = TokenLease(r_req, m, chunk_tokens=1000, durable=True)
+    await asyncio.sleep(1.5)  # first heartbeats
+    rows, n, t_end, next_probe = [], 0, time.monotonic() + drive_s, 0.0
+    ids = [g.id for g in regs]
+    while time.monotonic() < t_end:
+        for _ in range(int(RATE * TICK_S)):
+            sink.emit(record("org-a" if n % 2 else "org-b", n))
+            n += 1
+        if time.monotonic() >= next_probe:
+            rows.append(await probe(probe_r, w, lease, ids))
+            next_probe = time.monotonic() + 0.5
+        await asyncio.sleep(TICK_S)
+    await asyncio.sleep(1.0)
+    rows.append(await probe(probe_r, w, lease, ids))
+    await asyncio.to_thread(w.killswitch, "org", "org-b", True)  # the security consequence of H1
+    ks = VersionedKillSwitch(r_bg, m, K, refresh_ms=500, stale_ms=5000, identity=VersionedIdentity(r_bg, K))
+    try:
+        await ks.refresh_once()
+        enforced: bool | str = ks.org_killed("org-b")
+    except store.StoreError as exc:
+        enforced = f"refresh failed: {type(exc).__name__}"
+    xlen = {o: int(await probe_r.xlen(store.K_AUDIT_PREFIX + o)) for o in ("org-a", "org-b")}
+    for t in tasks:
+        t.cancel()
+    maxmem = rows[-1]["maxmemory"]
+    res = {
+        "tree": str(Path(sys.modules["rvproto"].__file__).resolve().parents[1]), "policy": rows[-1]["policy"], "maxmemory": maxmem, "records_emitted": n,
+        "audit_written": sink.written, "audit_write_failed": sink.failed, "audit_dropped": sink.dropped,
+        "audit_trimmed_records": getattr(sink, "trimmed", None), "xlen_end": xlen,
+        "regs_alive_min": min(r["regs_alive"] for r in rows), "evicted_keys_end": rows[-1]["evicted_keys"],
+        "publish_failures": sum(1 for r in rows if not r["publish_ok"]),
+        "lease_failures": sum(1 for r in rows if r["lease"] is not True),
+        "used_memory_max": max(r["used_memory"] for r in rows),
+        "killswitch_publish_status": (getattr(w, "last", None) or {}).get("status"), "killswitch_enforced": enforced,
+        "gauges": {k: v for k, v in m.gauge.items() if k.startswith(("store_", "audit_"))},
+        "counters": {k: v for k, v in m.count.items() if k.startswith(("audit_", "store_"))},
+        "timeline": rows,
+    }
+    res["PASS"] = (res["regs_alive_min"] == OWNERS and res["evicted_keys_end"] == 0 and res["publish_failures"] == 0
+                   and res["lease_failures"] == 0 and res["audit_write_failed"] == 0
+                   and res["used_memory_max"] < maxmem and res["killswitch_publish_status"] == "ok"
+                   and enforced is True)
+    return res
+
+
+if __name__ == "__main__":
+    out = uvloop.run(main(sys.argv[1], float(sys.argv[2]) if len(sys.argv) > 2 else 20.0))
+    print(json.dumps(out, default=str))
+    sys.exit(0 if out["PASS"] else 1)
