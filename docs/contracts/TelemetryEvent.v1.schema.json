{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroshield.ai/schemas/ai-mesh/TelemetryEvent.v1.json",
  "title": "TelemetryEventV1",
  "type": "object",
  "required": ["event_type", "action", "organization_id", "request_id"],
  "properties": {
    "event_type": { "type": "string" },
    "action": { "type": "string", "enum": ["allow", "block", "redact", "flag", "route"] },
    "organization_id": { "type": "integer", "minimum": 1 },
    "request_id": { "type": "string" },
    "user_id": { "type": ["integer", "null"] },
    "threat_type": { "type": "string" },
    "risk_score": { "type": "number" },
    "metadata": { "type": "object" }
  }
}
