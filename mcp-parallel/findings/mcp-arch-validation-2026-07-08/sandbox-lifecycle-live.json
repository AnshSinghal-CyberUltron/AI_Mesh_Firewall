{
  "org": "zeroshield",
  "container": "zeroshield-mcp-sandbox",
  "checks": {
    "cap_drop_all": true,
    "no_new_privileges": true,
    "readonly_rootfs": true,
    "mem_limit_mb": 2048,
    "pids_limit": 256,
    "cpu_quota": 0,
    "label_org_match": true,
    "label_role": "mcp-sandbox",
    "per_org_network": true,
    "gvisor_available": false
  },
  "running": true,
  "oom_killed": false,
  "networks": [
    "mcp_sandbox_net_zeroshield"
  ],
  "runtimes": [
    "io.containerd.runc.v2",
    "runc"
  ],
  "broker_health": "{\"status\":\"ok\",\"service\":\"mcp-broker\",\"docker_ok\":true}",
  "lifecyclePass": true
}