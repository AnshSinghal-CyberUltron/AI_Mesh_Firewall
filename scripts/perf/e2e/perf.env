# Non-secret environment for the perf E2E stack (task 1.2).
#
# The perf stack answers from the in-gateway loadtest stub, so it needs NO real
# provider credentials. That is deliberate: a latency harness must not depend on
# production secrets, and nothing here is sensitive.
#
# Tier-2 (Bedrock) is OFF by default. Turning it on requires real AWS credentials
# and would put a 1.3-1.8 s network call on the critical path, which measures
# Bedrock rather than the gateway.

POSTGRES_USER=ai_mesh_firewall
POSTGRES_PASSWORD=ai_mesh_firewall
POSTGRES_DB=ai_mesh_firewall

DJANGO_SECRET_KEY=perf-harness-not-a-secret-do-not-deploy
DEBUG=False

MCP_BROKER_INTERNAL_KEY=perf-harness-broker-key
POLICY_SIGNING_KEY=perf-harness-signing-key-not-a-secret

BEDROCK_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

GATEWAY_ALLOW_HTTP=1
GATEWAY_AUTH_ENABLED=true
