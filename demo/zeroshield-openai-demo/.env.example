# Point the stock OpenAI SDK at your ZeroShield gateway.
ZEROSHIELD_API_KEY=your-zeroshield-gateway-key
ZEROSHIELD_BASE_URL=https://aimeshgateway.zeroshield.ai/v1
# Local testing default: http://localhost:8300/v1
ZEROSHIELD_TIMEOUT=60
ZEROSHIELD_MAX_RETRIES=3
# Control service used for the SUPERUSER login gate (not the gateway).
# In-docker: http://control:8000 ; local dev default: http://127.0.0.1:8100
CONTROL_BASE_URL=http://127.0.0.1:8100
