# Production nginx — static UI, vhost config, and origin TLS are baked into the image.
# Build context: repo root (see infra/scripts/build-push-images.sh).
FROM nginx:1.27-alpine

RUN apk add --no-cache openssl \
    && rm -f /etc/nginx/conf.d/default.conf

COPY deploy/nginx.conf /etc/nginx/conf.d/01-http.conf
COPY deploy/nginx-ssl.conf /etc/nginx/conf.d/02-ssl.conf

# A-14/A-34: JSON edge-error handler included by every server{} block, plus the static JSON
# body it serves via error_page. Kept OUT of conf.d/ so nginx does not auto-load the .inc as a
# standalone config (only conf.d/*.conf is auto-included).
COPY deploy/edge-error.inc /etc/nginx/edge-error.inc
COPY deploy/edge-error.json /etc/nginx/edge_errors/__edge_error.json
COPY deploy/security-headers.inc /etc/nginx/security-headers.inc
COPY deploy/require-edge-https.inc /etc/nginx/require-edge-https.inc

# Superuser gate for the /demo/ reference app (HTTP Basic Auth). Credentials are
# baked from build args sourced from .env at build time; the htpasswd stores only
# the apr1 hash, never the plaintext password.
ARG DEMO_AUTH_USER=superuser
ARG DEMO_AUTH_PASSWORD=change-me
RUN printf '%s:%s\n' "${DEMO_AUTH_USER}" "$(openssl passwd -apr1 "${DEMO_AUTH_PASSWORD}")" \
        > /etc/nginx/demo.htpasswd \
    && chmod 644 /etc/nginx/demo.htpasswd

# Frontend production bundle (built before docker build on laptop/CI).
COPY frontend/dist/ /usr/share/nginx/html/

# Self-signed origin cert for Cloudflare "Full" mode (same SANs as ec2-generate-origin-ssl.sh).
RUN mkdir -p /etc/nginx/ssl \
    && openssl req -x509 -nodes -days 825 \
        -newkey rsa:2048 \
        -keyout /etc/nginx/ssl/origin.key \
        -out /etc/nginx/ssl/origin.crt \
        -subj "/CN=zeroshield.ai/O=ZeroShield/C=IN" \
        -addext "subjectAltName=DNS:aimeshfirewall.zeroshield.ai,DNS:aimeshbackend.zeroshield.ai,DNS:aimeshgateway.zeroshield.ai,DNS:zeroshield.ai" \
    && chmod 600 /etc/nginx/ssl/origin.key

EXPOSE 80 443
