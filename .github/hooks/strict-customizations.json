{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ./.github/hooks/scripts/inject_strict_policy.sh",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "bash ./.github/hooks/scripts/inject_strict_policy.sh",
        "timeout": 10
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "bash ./.github/hooks/scripts/inject_strict_policy.sh",
        "timeout": 10
      }
    ]
  }
}
