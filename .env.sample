# AI Mesh Firewall — copy to .env (never commit .env)
#
# Local dev:  cp .env.sample .env && docker compose up
# EC2 prod:   see .env.ec2.sample (full production overlay)
#
# Generate secrets (run once per environment):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"   # DJANGO_SECRET_KEY
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # POLICY_SIGNING_KEY
#   python -c "import secrets; print(secrets.token_hex(32))"       # GATEWAY_INTERNAL_API_KEY
# POLICY_SIGNING_KEY must match on control, gateway, and workers.

# ── Postgres ──
POSTGRES_USER=ai_mesh_firewall
POSTGRES_PASSWORD=ai_mesh_firewall
POSTGRES_DB=ai_mesh_firewall

# ── Django / secrets ──
# Keep DJANGO_SECRET_KEY stable for any environment whose DB already has encrypted
# model API keys. Changing it without reconnecting keys under Model Connection
# causes HTTP 422 at model routing in the Attack Simulator.
DJANGO_SECRET_KEY=change-me-in-production
POLICY_SIGNING_KEY=
GATEWAY_INTERNAL_API_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,control

# ── Redis / Celery ──
REDIS_URL=redis://redis:6379/0
GATEWAY_REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# ── Internal service URLs (Docker network) ──
AI_MESH_CONTROL_URL=http://control:8000
AIGUARDX_BACKEND_URL=http://control:8000
GATEWAY_URL=http://gateway:8300

# ── Local URLs (browser + Vite dev server on :8180) ──
FRONTEND_ORIGIN=http://127.0.0.1:8180
BACKEND_PUBLIC_URL=http://127.0.0.1:8180
GATEWAY_PUBLIC_URL=http://127.0.0.1:8180
GATEWAY_CORS_ORIGINS=http://127.0.0.1:8180,http://localhost:8180,http://127.0.0.1:5173,http://localhost:5173

# ── Vite (read by frontend container via docker-compose env_file) ──
VITE_FRONTEND_BASE_URL=http://127.0.0.1:8180
VITE_BACKEND_BASE_URL=http://127.0.0.1:8180
VITE_GATEWAY_BASE_URL=http://127.0.0.1:8180
VITE_GATEWAY_SAME_ORIGIN=false
# Module 2 live WebSocket in dev — requires true + recreate frontend: docker compose up -d frontend
VITE_ENABLE_REALTIME_NOTIFICATIONS=true

# ── Telemetry drain ──
TELEMETRY_DRAIN_INTERVAL_SEC=1.0
TELEMETRY_DRAIN_BATCH_SIZE=250
TELEMETRY_DRAIN_MODE=thread
ALERT_EMAIL_USE_CELERY=false

# ── Optional pilot ──
GATEWAY_MONGO_TELEMETRY_ENABLED=false
MONGO_URL=mongodb://mongo:27017

# ── Gateway ──
GATEWAY_AUTH_ENABLED=true
GATEWAY_ORG_ONLY_INFERENCE=true
GATEWAY_ALLOW_HTTP=1
GATEWAY_RAG_ENABLED=true
ENABLE_TIER2=true
SIMULATOR_DEFAULTS_ENABLED=true
CHROMA_URL=
# BYOK OpenAI — required for org models like gpt-5.2 (read by gateway via api_key_env_var).
OPENAI_API_KEY=

# ── Module 3 — LLMOps admission (gateway) ──
MODULE3_ADMISSION_MODE=passthrough
MODULE3_COSIGN_PUBLIC_KEY=

# ── Bedrock / ZeroShield guard (gateway — not shown in UI) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=openai.gpt-oss-120b-1:0
ZEROSHIELD_GUARD_MODEL_ID=bedrock/openai.gpt-oss-120b-1:0
ZEROSHIELD_GUARD_MODEL_NAME=zeroshield-guard-120b

# ── Production admin bootstrap (required on first deploy) ──
ZEROSHIELD_ADMIN_EMAIL=admin@zeroshield.io
ZEROSHIELD_ADMIN_PASSWORD=

# ── Security alerting — Microsoft Graph ──
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_SENDER_EMAIL=support@zeroshield.ai
