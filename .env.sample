# AI Mesh Firewall — copy to .env (never commit .env)
#
# Generate secrets (run once per environment):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"   # DJANGO_SECRET_KEY
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # POLICY_SIGNING_KEY
# POLICY_SIGNING_KEY must match on control, gateway, and workers.

POSTGRES_USER=ai_mesh_firewall
POSTGRES_PASSWORD=ai_mesh_firewall
POSTGRES_DB=ai_mesh_firewall

DJANGO_SECRET_KEY=change-me-in-production
POLICY_SIGNING_KEY=

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

TELEMETRY_DRAIN_INTERVAL_SEC=1.0
TELEMETRY_DRAIN_BATCH_SIZE=250

# Optional pilot
GATEWAY_MONGO_TELEMETRY_ENABLED=false
MONGO_URL=mongodb://mongo:27017

# ZeroShield guard model (gateway backend — not shown in UI)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=openai.gpt-oss-120b-1:0
ZEROSHIELD_GUARD_MODEL_ID=bedrock/openai.gpt-oss-120b-1:0
ZEROSHIELD_GUARD_MODEL_NAME=zeroshield-guard-120b
ENABLE_TIER2=true
SIMULATOR_DEFAULTS_ENABLED=true

# Security alerting — Microsoft Graph (application Mail.Send on sender mailbox)
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_SENDER_EMAIL=support@zeroshield.ai
# Process gateway telemetry in control container (thread) vs Celery beat (workers profile)
TELEMETRY_DRAIN_MODE=thread
ALERT_EMAIL_USE_CELERY=false

# Shared control↔gateway admin key (required for control proxy to /v1/admin/admission/verify).
GATEWAY_INTERNAL_API_KEY=

# Module 3 — LLMOps admission (gateway) and K8s ingest (control plane)
# passthrough = local/demo (Admission Simulator works without Cosign).
# verify = production: require Cosign public key and run cosign CLI.
# Prefer prod overlay instead of flipping this in .env by accident:
#   scripts/module3_gen_cosign_keypair.sh
#   docker compose -f docker-compose.yml -f docker-compose.module3-verify.yml up -d gateway
# Deny → Module 2 incidents need Celery workers (compose workers profile).
MODULE3_ADMISSION_MODE=passthrough
# Inline PEM, or path. Prefer FILE/PATH in production (Docker secret / mount).
# Overlay sets MODULE3_COSIGN_PUBLIC_KEY_FILE=/run/secrets/cosign.pub (secrets/cosign.pub on host).
MODULE3_COSIGN_PUBLIC_KEY=
MODULE3_COSIGN_PUBLIC_KEY_PATH=
MODULE3_COSIGN_PUBLIC_KEY_FILE=
MODULE3_COSIGN_BINARY=cosign
MODULE3_COSIGN_TIMEOUT_SEC=45
# 1 = cosign verify <image> (OCI registry signatures).
# 0 = cosign verify-blob on model/data SHA-256 + detached signature_digest (CI).
MODULE3_COSIGN_VERIFY_IMAGE=0
# Optional extra CLI flags, e.g. --insecure-ignore-tlog for air-gapped registries
MODULE3_COSIGN_EXTRA_ARGS=

# Module 3 agent ingest (cluster heartbeat / network / embedding). Required for live K8s page e2e.
AGENT_API_KEY=
