# AI Mesh Firewall — copy to .env (never commit .env)

POSTGRES_USER=ai_mesh_firewall
POSTGRES_PASSWORD=ai_mesh_firewall
POSTGRES_DB=ai_mesh_firewall

DJANGO_SECRET_KEY=change-me-in-production
POLICY_SIGNING_KEY=

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

TELEMETRY_DRAIN_INTERVAL_SEC=1.0
TELEMETRY_DRAIN_BATCH_SIZE=250

# Optional pilot
GATEWAY_MONGO_TELEMETRY_ENABLED=false
MONGO_URL=mongodb://mongo:27017

# ZeroShield guard model (gateway backend — not shown in UI)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=openai.gpt-oss-120b-1:0
ZEROSHIELD_GUARD_MODEL_ID=bedrock/openai.gpt-oss-120b-1:0
ZEROSHIELD_GUARD_MODEL_NAME=zeroshield-guard-120b
ENABLE_TIER2=true
SIMULATOR_DEFAULTS_ENABLED=true
