# AI Mesh Firewall — copy to .env (never commit .env)

POSTGRES_USER=ai_mesh_firewall
POSTGRES_PASSWORD=ai_mesh_firewall
POSTGRES_DB=ai_mesh_firewall

DJANGO_SECRET_KEY=change-me-in-production
POLICY_SIGNING_KEY=rRs6ZJEUxAQ4r0n0noSDaHMFeaS0vS47gVaZrIN5rvY=

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

TELEMETRY_DRAIN_INTERVAL_SEC=1.0
TELEMETRY_DRAIN_BATCH_SIZE=250

# Optional pilot
GATEWAY_MONGO_TELEMETRY_ENABLED=true
MONGO_URL=mongodb://mongo:27017

BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=openai.gpt-oss-120b-1:0
AWS_ACCESS_KEY_ID=AKIA5T2YUFAY5IVCRYEY
AWS_SECRET_ACCESS_KEY=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


ENABLE_TIER2=true
GATEWAY_INPUT_SCAN_ENABLED=true
DATABASE_URL=postgresql://ai_mesh_firewall:ai_mesh_firewall@postgres:5432/ai_mesh_firewall

# --- Tier 1.6 Embedding Vault (DEV default) ---
# TODO(Phase 1.5): replace with real BYO embedding pipeline (client-supplied
# provider+model, per-org isolation, vector validation, embedding circuit breaker).
# For now we use Bedrock Titan v2 @ 1024 dims so Tier 1.6 works out-of-the-box
# in dev without requiring an OpenAI key. Override via env in production:
#   GATEWAY_EMBEDDING_VAULT_MODEL=<litellm-model-id>
#   GATEWAY_EMBEDDING_VAULT_DIM=<int>
#   GATEWAY_EMBEDDING_VAULT_ENABLED=false   # to disable Tier 1.6 entirely
GATEWAY_EMBEDDING_VAULT_MODEL=bedrock/amazon.titan-embed-text-v2:0
GATEWAY_EMBEDDING_VAULT_DIM=1024

# Phase 1 Fx-2b: shared secret for control->gateway admin proxy
GATEWAY_INTERNAL_API_KEY=89ddf101be71d58f31a41c4851502a677f84a86111621be4502fac13d17779bf


