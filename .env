# --- Tier 1.6 Embedding Vault (DEV default) ---
# TODO(Phase 1.5): replace with real BYO embedding pipeline (client-supplied
# provider+model, per-org isolation, vector validation, embedding circuit breaker).
# For now we use Bedrock Titan v2 @ 1024 dims so Tier 1.6 works out-of-the-box
# in dev without requiring an OpenAI key. Override via env in production:
#   GATEWAY_EMBEDDING_VAULT_MODEL=<litellm-model-id>
#   GATEWAY_EMBEDDING_VAULT_DIM=<int>
#   GATEWAY_EMBEDDING_VAULT_ENABLED=false   # to disable Tier 1.6 entirely
GATEWAY_EMBEDDING_VAULT_MODEL=bedrock/amazon.titan-embed-text-v2:0
GATEWAY_EMBEDDING_VAULT_DIM=1024

