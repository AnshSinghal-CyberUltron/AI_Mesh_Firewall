.env
.env.*
!.env.sample

# Cosign private keys / live pubkeys (keep example + .gitkeep under secrets/)
secrets/cosign.key
secrets/cosign.pub
secrets/*.key
!secrets/.gitkeep
!secrets/cosign.pub.example
!secrets/.gitignore

# Local Kind/helm toolchain downloads
.tools/

__pycache__/
*.pyc
.venv/
node_modules/
dist/
*.egg-info/
.pytest_cache/
.coverage
postgres_data/
*.log
.DS_Store

# Verification run artifacts (may contain bearer tokens, payloads, screenshots)
runs/verification/
runs/cosign-e2e/

# Terraform cache
**/.terraform/*

# State files
*.tfstate
*.tfstate.*

# Crash logs
crash.log

# Keep dependency lock file
!.terraform.lock.hcl